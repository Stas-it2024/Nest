<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Nest/Nest.csproj" />
    <None Update="StaySqlBaseline.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Compile current production bodies with only transport, namespace and dialog dependencies replaced. -->
  <UsingTask TaskName="GenerateStayIsolation" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <RepositoryRoot ParameterType="System.String" Required="true" />
      <OutputDirectory ParameterType="System.String" Required="true" />
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Directory.CreateDirectory(OutputDirectory);
        var repositorySource = File.ReadAllText(Path.Combine(RepositoryRoot, "Nest/Data/ReservationRipository.cs"));
        var viewModelSource = File.ReadAllText(Path.Combine(RepositoryRoot, "Nest/ViewModels/Reception/ReservationManagementViewModel.cs"));
        if (!repositorySource.Contains("using MySql.Data.MySqlClient;") || !repositorySource.Contains("namespace Nest.Data") ||
            !viewModelSource.Contains("using MySql.Data.MySqlClient;") || !viewModelSource.Contains("using Nest.Data;") ||
            !viewModelSource.Contains("namespace Nest.ViewModels.Reception") || !viewModelSource.Contains("System.Windows.MessageBox.Show"))
            throw new System.InvalidOperationException("Production isolation anchors changed; refusing to build potentially non-isolated tests.");
        var repository = repositorySource
            .Replace("using MySql.Data.MySqlClient;", "using StayTests.Fakes;")
            .Replace("namespace Nest.Data", "namespace StayTests.Data");
        var viewModel = viewModelSource
            .Replace("using MySql.Data.MySqlClient;", "using StayTests.Fakes;")
            .Replace("using Nest.Data;", "using StayTests.Data;\nusing Nest.ViewModels.Reception;")
            .Replace("namespace Nest.ViewModels.Reception", "namespace StayTests.Ui")
            .Replace("System.Windows.MessageBox.Show", "StayTests.Dialog.Show");
        var repositoryPath = Path.Combine(OutputDirectory, "Repository.cs");
        var viewModelPath = Path.Combine(OutputDirectory, "ViewModel.cs");
        File.WriteAllText(repositoryPath, repository);
        File.WriteAllText(viewModelPath, viewModel);
        Sources = new Microsoft.Build.Framework.ITaskItem[] {
            new Microsoft.Build.Utilities.TaskItem(repositoryPath),
            new Microsoft.Build.Utilities.TaskItem(viewModelPath) };
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="GenerateStayTestSources" BeforeTargets="CoreCompile">
    <GenerateStayIsolation RepositoryRoot="$(MSBuildProjectDirectory)/../.." OutputDirectory="$(IntermediateOutputPath)StayIsolation">
      <Output TaskParameter="Sources" ItemName="Compile" />
    </GenerateStayIsolation>
  </Target>
</Project>
