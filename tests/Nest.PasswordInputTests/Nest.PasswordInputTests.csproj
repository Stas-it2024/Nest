<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../Nest/Nest.csproj" /></ItemGroup>
  <!-- Current ViewModel bodies with only Repository, Shell, dialogs and namespaces substituted.
       Tests also load the actual compiled production Views and password binding behavior. -->
  <UsingTask TaskName="GeneratePasswordUiIsolation" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Root ParameterType="System.String" Required="true" />
      <OutputDirectory ParameterType="System.String" Required="true" />
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Directory.CreateDirectory(OutputDirectory);
        var files = new[] { "Nest/ViewModels/Admin/BenutzerViewModel.cs", "Nest/ViewModels/Authentication/LoginViewModel.cs" };
        var sources = new System.Collections.Generic.List<Microsoft.Build.Framework.ITaskItem>();
        foreach (var file in files) {
          var source = File.ReadAllText(Path.Combine(Root, file));
          if (!source.Contains("using Nest.Data;") || !source.Contains("using MySql.Data.MySqlClient;") ||
              !source.Contains("MessageBox.Show") || !source.Contains("new UserRepository()"))
            throw new System.InvalidOperationException("Password UI isolation anchors changed.");
          source = source.Replace("using Nest.Data;", "using PasswordInputTests.Data;")
                         .Replace("using MySql.Data.MySqlClient;", "using PasswordInputTests.Fakes;")
                         .Replace("using Nest.ViewModels.Shell;", "using PasswordInputTests.Ui.Shell;")
                         .Replace("namespace Nest.ViewModels.", "namespace PasswordInputTests.Ui.")
                         .Replace("System.Windows.MessageBox.Show", "PasswordInputTests.Dialog.Show")
                         .Replace("MessageBox.Show", "PasswordInputTests.Dialog.Show");
          if (source.Contains("Nest.Data") || source.Contains("Nest.ViewModels") ||
              source.Contains("DB.") || source.Contains("Credential") || source.Contains("MySqlConnection"))
            throw new System.InvalidOperationException("Password UI isolation contains a forbidden dependency.");
          var path = Path.Combine(OutputDirectory, Path.GetFileName(file));
          File.WriteAllText(path, source); sources.Add(new Microsoft.Build.Utilities.TaskItem(path));
        }
        Sources = sources.ToArray();
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="GeneratePasswordTestSources" BeforeTargets="CoreCompile">
    <GeneratePasswordUiIsolation Root="$(MSBuildProjectDirectory)/../.." OutputDirectory="$(IntermediateOutputPath)PasswordIsolation">
      <Output TaskParameter="Sources" ItemName="Compile" />
    </GeneratePasswordUiIsolation>
  </Target>
</Project>
