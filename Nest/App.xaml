<Application x:Class="Nest.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Nest">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/DataGridStyles.xaml"/>
                <ResourceDictionary Source="Styles/ButtonStyles.xaml"/>
                <ResourceDictionary>
                    <local:Bootstrapper x:Key="Bootstrapper"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <!-- REC TEXTBOX -->
            <Style x:Key="RecTextBox" TargetType="TextBox">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CCC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="5,0,5,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <!-- REC COMBOBOX -->
            <Style x:Key="RecComboBox" TargetType="ComboBox">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CCC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="5,0,5,0"/>
            </Style>

            <!-- REC DATEPICKER -->
            <Style x:Key="RecDatePicker" TargetType="DatePicker">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CCC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
            </Style>

            <!-- REC LABEL -->
            <Style x:Key="RecLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#FF174A92"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
