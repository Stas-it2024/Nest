<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:Nest.Converters">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Palette.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <converters:GermanValueConverter x:Key="GermanValueConverter"/>
    <DataTemplate x:Key="GermanValueItemTemplate">
        <TextBlock Text="{Binding Converter={StaticResource GermanValueConverter}, Mode=OneWay}"/>
    </DataTemplate>
    <Style x:Key="PageHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="25,0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="StaffBrandTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="StaffHotelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StaffBrandTextStyle}">
        <Setter Property="FontSize" Value="26"/>
    </Style>
    <Style x:Key="StaffInfoTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource StaffInfoBrush}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="EntryBrandTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="48"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="LoginFormLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="LoginInputBaseStyle" TargetType="Control">
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Padding" Value="5,-2,0,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="LoginTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource LoginInputBaseStyle}"/>
    <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox" BasedOn="{StaticResource LoginInputBaseStyle}"/>

    <!-- These explicit styles are applied through the existing view-scoped implicit styles. -->
    <Style x:Key="AdminFormLabelStyle" TargetType="Label">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="8,0"/>
    </Style>
    <Style x:Key="AdminFormComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Margin" Value="10,0,10,10"/>
        <Setter Property="Height" Value="30"/>
    </Style>
    <Style x:Key="AdminFormTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="10,0,10,10"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style x:Key="ToolbarLabelStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="ToolbarSearchTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="30"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
    <Style x:Key="DashboardMetricCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Height" Value="125"/>
        <Setter Property="Padding" Value="8"/>
    </Style>
    <Style x:Key="DashboardMetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="DashboardMetricLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="DashboardSectionHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="#E4EFFA"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>
    <Style x:Key="DashboardSectionHeadingStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PageHeaderBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
</ResourceDictionary>
