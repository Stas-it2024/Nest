<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:layout="clr-namespace:Nest.Views.Behaviors">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Palette.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="StandardDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource PageHeaderBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="5,4"/>
        <Setter Property="BorderBrush" Value="#E6EFF9"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style x:Key="StandardDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#202D3D"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#B8D1F5"/>
                <Setter Property="Foreground" Value="Black"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StandardDataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Padding" Value="8,0,4,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!-- The cell template must forward Padding to its content, including text columns. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <!-- Extend the content's status color across the cell; inset only the content. -->
                        <Border x:Name="ContentBackground"
                                Background="{Binding Content.Background, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=Transparent, FallbackValue=Transparent}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ContentBackground" Property="Background" Value="#B8D1F5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#B8D1F5"/>
                <Setter Property="Foreground" Value="Black"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StandardDataGridRowHeaderStyle" TargetType="DataGridRowHeader">
        <Setter Property="Background" Value="#F0F4F9"/>
        <Setter Property="BorderBrush" Value="#DCE4EE"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRowHeader">
                    <Border x:Name="RowHeaderBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Path x:Name="SelectionArrow" Data="M 0,0 L 8,5 L 0,10 Z"
                                  Fill="Black" Width="8" Height="10" Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsHitTestVisible="False"/>
                            <Thumb x:Name="PART_TopHeaderGripper" Height="3" VerticalAlignment="Top"
                                   Cursor="SizeNS" Opacity="0"/>
                            <Thumb x:Name="PART_BottomHeaderGripper" Height="3" VerticalAlignment="Bottom"
                                   Cursor="SizeNS" Opacity="0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsRowSelected" Value="True">
                            <Setter TargetName="RowHeaderBorder" Property="Background" Value="#2D6FBE"/>
                            <Setter TargetName="SelectionArrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="StandardDataGridStyle" TargetType="DataGrid">
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#202D3D"/>
        <Setter Property="RowHeaderWidth" Value="40"/>
        <Setter Property="RowHeight" Value="28"/>
        <Setter Property="ColumnHeaderHeight" Value="30"/>
        <Setter Property="HeadersVisibility" Value="All"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#E1E7EF"/>
        <Setter Property="VerticalGridLinesBrush" Value="#E1E7EF"/>
        <Setter Property="BorderBrush" Value="#D5DFEB"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource StandardDataGridColumnHeaderStyle}"/>
        <Setter Property="RowStyle" Value="{StaticResource StandardDataGridRowStyle}"/>
        <Setter Property="CellStyle" Value="{StaticResource StandardDataGridCellStyle}"/>
        <Setter Property="RowHeaderStyle" Value="{StaticResource StandardDataGridRowHeaderStyle}"/>
    </Style>

    <!-- Reference last in text element triggers so selection overrides status colors. -->
    <DataTrigger x:Key="StandardDataGridTextSelectionTrigger" x:Shared="False" Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
        <Setter Property="TextBlock.Background" Value="#B8D1F5"/>
        <Setter Property="TextBlock.Foreground" Value="Black"/>
    </DataTrigger>
    <Style x:Key="ReservationStatusTextStyle" TargetType="TextBlock">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Reserviert">
                <Setter Property="Background" Value="Gold"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Eingecheckt">
                <Setter Property="Background" Value="LightGreen"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Ausgecheckt">
                <Setter Property="Background" Value="LightGray"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Storniert">
                <Setter Property="Background" Value="LightCoral"/>
            </DataTrigger>
            <StaticResource ResourceKey="StandardDataGridTextSelectionTrigger"/>
        </Style.Triggers>
    </Style>
    <!-- Opt-in layout profile: retain the existing palette/templates and all local overrides. -->
    <Style x:Key="StandardResizableCellStyle" TargetType="DataGridCell"
           BasedOn="{StaticResource StandardDataGridCellStyle}">
        <Setter Property="Padding" Value="6,0,6,0"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StandardResizableDataGridStyle" TargetType="DataGrid"
           BasedOn="{StaticResource StandardDataGridStyle}">
        <Setter Property="CellStyle" Value="{StaticResource StandardResizableCellStyle}"/>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StandardDataGridColumnHeaderStyle}">
                    <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="CanUserSortColumns" Value="True"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="layout:EmptyDataGridExtent.IsEnabled" Value="True"/>
        <Style.Triggers>
            <Trigger Property="HasItems" Value="False">
                <!-- No row exists to supply IScrollInfo's extent. Measure the empty host in pixels. -->
                <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StandardGridTextStyle" TargetType="TextBlock"
           BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Style>
    <Style x:Key="StandardGridNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource StandardGridTextStyle}">
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="StandardGridReservationStatusStyle" TargetType="TextBlock"
           BasedOn="{StaticResource ReservationStatusTextStyle}">
        <Setter Property="Margin" Value="2,0,2,0"/>
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Style>
</ResourceDictionary>
