<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Bestehende Aktionsfarben; auch lokale Layout-Styles verwenden diese Palette. -->
    <SolidColorBrush x:Key="PrimaryButtonBackground" Color="#007ACC"/>
    <SolidColorBrush x:Key="SuccessButtonBackground" Color="#28A745"/>
    <SolidColorBrush x:Key="DangerButtonBackground" Color="#DC3545"/>
    <SolidColorBrush x:Key="SecondaryButtonBackground" Color="#6C757D"/>

    <Style x:Key="BaseActionButtonStyle" TargetType="Button">
        <Style.Resources>
            <CornerRadius x:Key="ActionButtonCornerRadius">0</CornerRadius>
        </Style.Resources>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="ButtonRoot" SnapsToDevicePixels="True">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ActionButtonCornerRadius}"/>
                        <!-- Abdunklung folgt jeder Grundfarbe, auch lokalen Background-Werten. -->
                        <Border x:Name="StateTint" Background="Black" Opacity="0"
                                CornerRadius="{DynamicResource ActionButtonCornerRadius}"
                                IsHitTestVisible="False"/>
                        <ContentPresenter x:Name="ButtonContent"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateTint" Property="Opacity" Value="0.10"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="StateTint" Property="Opacity" Value="0.28"/>
                        </Trigger>
                        <!-- Disabled hat Vorrang vor Hover und Pressed. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="StateTint" Property="Background" Value="White"/>
                            <Setter TargetName="StateTint" Property="Opacity" Value="0.55"/>
                            <Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="#404040"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sitzungsaktionen: Sidebar-Geometrie mit dem gemeinsamen Button-Template. -->
    <Style x:Key="AdminSystemButtonStyle" TargetType="Button"
           BasedOn="{StaticResource BaseActionButtonStyle}">
        <Setter Property="Height" Value="45"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Background" Value="#0F284B"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="20,0,0,0"/>
    </Style>
    <Style x:Key="AdminLogoutButtonStyle" TargetType="Button"
           BasedOn="{StaticResource AdminSystemButtonStyle}">
        <Setter Property="Foreground" Value="#FFB6B6"/>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="#493047"/>
                <Setter Property="Foreground" Value="#FF9EAA"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True"/>
                    <Condition Property="IsPressed" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="#511F30"/>
                <Setter Property="Foreground" Value="#FFE3E7"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="AdminExitButtonStyle" TargetType="Button"
           BasedOn="{StaticResource AdminSystemButtonStyle}">
        <Setter Property="Foreground" Value="#C4CEDD"/>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="#34465E"/>
                <Setter Property="Foreground" Value="#E4EBF5"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True"/>
                    <Condition Property="IsPressed" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="#302C3C"/>
                <Setter Property="Foreground" Value="#EBDDE3"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButtonStyle}">
        <Setter Property="Background" Value="{StaticResource PrimaryButtonBackground}"/>
    </Style>
    <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButtonStyle}">
        <Setter Property="Background" Value="{StaticResource SuccessButtonBackground}"/>
    </Style>
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButtonStyle}">
        <Setter Property="Background" Value="{StaticResource DangerButtonBackground}"/>
    </Style>
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButtonStyle}">
        <Setter Property="Background" Value="{StaticResource SecondaryButtonBackground}"/>
    </Style>
    <Style x:Key="SearchButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="#174A92"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="ResetButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Background" Value="Gray"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="PortalPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="#1F497D"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Bestehende Ressourcennamen bleiben für Login und Portal gültig. -->
    <Style x:Key="BlueButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="#234D87"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Height" Value="45"/>
    </Style>
    <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource SuccessButtonStyle}">
        <Setter Property="Background" Value="#00995A"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Height" Value="45"/>
    </Style>
    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource BaseActionButtonStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="Gray"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Kleine Eingabehilfen behalten bewusst ihr WPF-Template und ihre Abmessungen. -->
    <Style x:Key="TextBoxTaste" TargetType="Button">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="FontSize" Value="8"/>
        <Setter Property="Background" Value="#F5F5F5"/>
    </Style>
</ResourceDictionary>
