<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Palette.xaml"/>
    </ResourceDictionary.MergedDictionaries>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- Bestehende Eingaben für die Zimmerbuchung. -->
        <Style x:Key="OutlinedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PortalTextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource PortalTextBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border BorderBrush="#8A8A8A"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    Margin="0,12,0,0"/>
                            <Grid Margin="-1,0,50,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Height="14">
                                <Border Background="White"
                                        Width="200"
                                        Padding="5,0">
                                    <TextBlock Text="{TemplateBinding Tag}"
                                               Foreground="#666"
                                               FontSize="12"/>
                                </Border>
                            </Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="5,10,8,0"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stil für Hauptschaltflächen (dein vorhandener) -->
        <Style x:Key="PrimaerAktionButtonStil" TargetType="Button"
               BasedOn="{StaticResource PortalPrimaryButtonStyle}">
            <Style.Resources>
                <CornerRadius x:Key="ActionButtonCornerRadius">0</CornerRadius>
            </Style.Resources>
            <Setter Property="BorderBrush" Value="DarkSlateGray"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <!-- Lokales Gestaltungssystem für Auto, Taxi und Restaurant. -->
        <Style x:Key="KundenFormKartenStil" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PortalBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="KundenFormTitelStil" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PortalHeadingBrush}"/>
        </Style>

        <Style x:Key="KundenFormLabelStil" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#28384A"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="KundenFormTextBoxStil" TargetType="TextBox">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource PortalTextBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B8C5D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="EingabeRahmen"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EingabeRahmen" Property="BorderBrush" Value="#7794B5"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="EingabeRahmen" Property="BorderBrush" Value="#1F497D"/>
                                <Setter TargetName="EingabeRahmen" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="EingabeRahmen" Property="Background" Value="#EEF2F6"/>
                                <Setter Property="Foreground" Value="#7B8794"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KundenFormMehrzeiligTextBoxStil"
               TargetType="TextBox"
               BasedOn="{StaticResource KundenFormTextBoxStil}">
            <Setter Property="MinHeight" Value="100"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="KundenFormAuswahlStil" TargetType="Control">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource PortalTextBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B8C5D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#7794B5"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#1F497D"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#EEF2F6"/>
                    <Setter Property="Foreground" Value="#7B8794"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Der interne Datumstext bleibt auch in der Standard-DatePicker-Vorlage mittig. -->
        <Style TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="KundenFormZusammenfassungStil" TargetType="Border">
            <Setter Property="Background" Value="#EEF5FC"/>
            <Setter Property="BorderBrush" Value="#C8D9EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="16,13"/>
        </Style>

        <Style x:Key="KundenPortalBereichStil" TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource PortalTextBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="{StaticResource PortalHeadingBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="4,0,4,4"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Originale Kontaktdaten-Gestaltung; andere Bereiche behalten ihr neues Layout. -->
        <Style x:Key="KontaktBereichStil" TargetType="GroupBox"
               BasedOn="{StaticResource KundenPortalBereichStil}">
            <Setter Property="BorderBrush" Value="{StaticResource PortalBorderBrush}"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="ZimmerVorschauKartenStil" TargetType="Border">
            <Setter Property="Background" Value="#F7F9FC"/>
            <Setter Property="BorderBrush" Value="{StaticResource PortalBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="EventKartenStil" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PortalBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="KundenFormAktionStil" TargetType="Button"
               BasedOn="{StaticResource PortalPrimaryButtonStyle}">
            <Style.Resources>
                <CornerRadius x:Key="ActionButtonCornerRadius">0</CornerRadius>
            </Style.Resources>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="#1F497D"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#76A9DC"/>
                    <Setter Property="BorderThickness" Value="3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KundenPortalTabStil" TargetType="TabItem">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PortalTextBrush}"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Padding" Value="24,7"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabRahmen"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#D8D8D8"
                                BorderThickness="1,1,1,0"
                                CornerRadius="0"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabRahmen" Property="Background" Value="#E4EDF7"/>
                                <Setter TargetName="TabRahmen" Property="TextElement.Foreground" Value="{StaticResource PortalHeadingBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabRahmen" Property="Background" Value="White"/>
                                <Setter TargetName="TabRahmen" Property="TextElement.Foreground" Value="{StaticResource PortalTextBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabRahmen" Property="Background" Value="White"/>
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabRahmen" Property="BorderBrush" Value="#76A9DC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stil für Abmelden-Button (dein vorhandener) -->
        <Style x:Key="AbmeldenButtonStil" TargetType="Button"
               BasedOn="{StaticResource DangerButtonStyle}">
            <Style.Resources>
                <CornerRadius x:Key="ActionButtonCornerRadius">0</CornerRadius>
            </Style.Resources>
            <Setter Property="Background" Value="#C00000"/>
            <Setter Property="BorderBrush" Value="#C00000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="30,0"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
</ResourceDictionary>
