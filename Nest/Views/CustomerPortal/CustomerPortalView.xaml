                                                 AutomationProperties.AutomationId="EventGuestName"
                                                 Style="{StaticResource KundenFormTextBoxStil}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="8,0">
                                        <TextBlock Text="E-Mail *"
                                                   Style="{StaticResource KundenFormLabelStil}"/>
                                        <TextBox Text="{Binding KundenEmail, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.AutomationId="EventGuestEmail"
                                                 Style="{StaticResource KundenFormTextBoxStil}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="8,0">
                                        <TextBlock Text="Telefon *"
                                                   Style="{StaticResource KundenFormLabelStil}"/>
                                        <TextBox Text="{Binding KundenTelefon, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.AutomationId="EventGuestPhone"
                                                 Style="{StaticResource KundenFormTextBoxStil}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                        <TextBlock Text="Anzahl *"
                                                   Style="{StaticResource KundenFormLabelStil}"/>
                                        <TextBox Text="{Binding AnzahlTickets, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.AutomationId="EventTicketQuantity"
                                                 Style="{StaticResource KundenFormTextBoxStil}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Grid.Row="2"
                                           Text="{Binding Statusmeldung}"
                                           Margin="0,14,0,0"
                                           Foreground="#173A67"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

