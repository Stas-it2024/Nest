                                        <DataTemplate>
                                            <Border Style="{StaticResource EventKartenStil}">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding PreisText}"
                                                                   DockPanel.Dock="Right"
                                                                   Foreground="#173A67"
                                                                   FontWeight="Bold"
                                                                   FontSize="15"/>
                                                        <TextBlock Text="{Binding Titel}"
                                                                   FontWeight="Bold"
                                                                   FontSize="18"
                                                                   Foreground="#173A67"/>
                                                    </DockPanel>

                                                    <TextBlock Text="{Binding Beschreibung}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,8,0,10"
                                                               Foreground="#1F2937"/>

                                                    <WrapPanel Margin="0,0,0,4">
                                                        <TextBlock Text="Datum: "
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#5B6472"/>
                                                        <TextBlock Text="{Binding DatumText}"
                                                                   Foreground="#5B6472"
                                                                   Margin="0,0,22,0"/>
                                                        <TextBlock Text="Uhrzeit: "
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#5B6472"/>
                                                        <TextBlock Text="{Binding UhrzeitText}"
                                                                   Foreground="#5B6472"
                                                                   Margin="0,0,22,0"/>
                                                        <TextBlock Text="Ort: "
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#5B6472"/>
                                                        <TextBlock Text="{Binding Ort}"
                                                                   Foreground="#5B6472"/>
