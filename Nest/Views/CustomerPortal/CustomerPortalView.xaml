                                                    <TextBlock Margin="0,4,0,0"
                                                               Foreground="#2F6B3B"
                                                               FontWeight="SemiBold">
                                                        <Run Text="Verfügbare Tickets: "/>
                                                        <Run Text="{Binding VerfuegbareTickets, Mode=OneWay}"/>
                                                        <Run Text=" von "/>
                                                        <Run Text="{Binding MaximaleTickets, Mode=OneWay}"/>
                                                    </TextBlock>

                                                    <!-- $dataContext übergibt genau die Veranstaltung dieser Kartenzeile an die Aktion des Eltern-ViewModels. -->
                                                    <Button Content="Tickets buchen"
                                                            cal:Message.Attach="[Action TicketKaufen($dataContext)]"
                                                            cal:Action.TargetWithoutContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
