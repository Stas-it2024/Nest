                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,16">
                                        <TextBlock Text="Betrag *"
                                                   Style="{StaticResource KundenFormLabelStil}"/>
                                        <Grid>
                                            <TextBox Text="{Binding Zahlungsbetrag, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource KundenFormTextBoxStil}"
                                                     Padding="12,0,42,0"/>
                                            <TextBlock Text="€"
                                                       Foreground="#5B6472"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,14,0"
                                                       IsHitTestVisible="False"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                                        <TextBlock Text="Verwendungszweck"
                                                   Style="{StaticResource KundenFormLabelStil}"/>
                                        <TextBox Text="{Binding Verwendungszweck, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource KundenFormTextBoxStil}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Message.Attach ruft die Zahlungslogik im ViewModel auf; die View bleibt ohne Datenbanklogik. -->
                                <Button Grid.Row="7"
                                        Content="JETZT ONLINE BEZAHLEN"
                                        cal:Message.Attach="[Action OnlineBezahlen]"
                                        Style="{StaticResource KundenFormAktionStil}"
                                        Margin="0,24,0,0"/>

                                <Border Grid.Row="8"
                                        Background="#EEF5FC"
                                        CornerRadius="7"
                                        Padding="14,11"
                                        Margin="0,14,0,0">
                                    <TextBlock Text="{Binding Statusmeldung}"
                                               Foreground="#173A67"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <Grid Grid.Row="9" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="210"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding LetzterPdfPfadText}"
                                               Foreground="#5B6472"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="0,0,16,0"/>

                                    <!-- Das Öffnen ist eine eigene Aktion, damit ein bereits erzeugter Beleg erneut angezeigt werden kann. -->
                                    <Button Grid.Column="1"
                                            Content="PDF-TICKET ÖFFNEN"
                                            cal:Message.Attach="[Action PdfOeffnen]"
                                            Style="{StaticResource PrimaerAktionButtonStil}"
                                            Height="44"
                                            Margin="0"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
