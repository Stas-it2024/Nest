                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              Background="#F4F7FB">
                    <StackPanel DataContext="{Binding Veranstaltungen}" Margin="14">
                        <Border Style="{StaticResource KundenFormKartenStil}"
                                Margin="0,0,0,14">
