<UserControl x:Class="Nest.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Nest.Views"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT MENU -->
        <Border Grid.Column="0" Background="#17345C">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Margin="10,20">
                    <TextBlock Text="Grand Horizon"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Hotel"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                    <Separator Margin="0,15"/>

                    <TextBlock Text="System Administrator"
                               Foreground="#B8C6DA"
                               FontSize="15"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="(Admin)"
                               Foreground="#B8C6DA"
                               FontSize="15"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1">

                    <Button Content="Dashboard"
                            Height="55"
                            FontSize="18"
                            Background="#2A558B"
                            Foreground="White"
                            BorderThickness="0"/>

                    <Button Content="Zimmer"
                            Height="55"
                            FontSize="18"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"/>

                    <Button Content="Benutzer"
                            Height="55"
                            FontSize="18"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"/>

                    <Button Content="Dienstleistungen"
                            Height="55"
                            FontSize="18"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"/>

                    <Button Content="Events"
                            Height="55"
                            FontSize="18"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"/>

                    <Button Content="Alle Reservierungen"
                            Height="55"
                            FontSize="18"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"/>
                </StackPanel>

                <!-- Bottom buttons -->
                <StackPanel Grid.Row="2" Margin="0,0,0,20">
                    <Button Content="Abmelden"
                            Height="50"
                            FontSize="16"
                            Foreground="#FFB6B6"
                            Background="Transparent"
                            BorderThickness="0"/>

                    <Button Content="Beenden"
                            Height="50"
                            FontSize="16"
                            Foreground="#B8D8FF"
                            Background="Transparent"
                            BorderThickness="0"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="130"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Background="#224E87">
                <TextBlock Text="Dashboard - Gesamtuebersicht"
                           VerticalAlignment="Center"
                           Margin="25,0"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="Bold"/>
            </Border>

            <!-- Statistics -->
            <UniformGrid Grid.Row="1"
                         Columns="8"
                         Margin="10">

                <Border Background="#2E5A92" Margin="5">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="8"
                                   FontSize="40"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Zimmer Gesamt"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="Green" Margin="5">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="8"
                                   FontSize="40"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Verfügbar"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="#D90000" Margin="5">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="0"
                                   FontSize="40"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Belegt"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="#B8860B" Margin="5">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="0"
                                   FontSize="40"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Reserviert"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="#0E75C7" Margin="5">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="0"
                                   FontSize="40"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Heute Check-in"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="#6A0DAD" Margin="5">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="0"
                                   FontSize="40"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Heute Check-out"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="#0B6B59" Margin="5">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="7"
                                   FontSize="40"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Gaeste Gesamt"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="#2B2B2B" Margin="5">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="EUR"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="1969,74"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Gesamtumsatz"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Tables -->
            <Grid Grid.Row="2" Margin="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Reservations -->
                <GroupBox Header="Letzte Reservierungen"
                          FontWeight="Bold"
                          Margin="0,0,5,0">

                    <DataGrid AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Buchung"
                                                Binding="{Binding BookingId}"/>
                            <DataGridTextColumn Header="Gast"
                                                Binding="{Binding Guest}"/>
                            <DataGridTextColumn Header="Zimmer"
                                                Binding="{Binding Room}"/>
                            <DataGridTextColumn Header="Typ"
                                                Binding="{Binding Type}"/>
                            <DataGridTextColumn Header="Check-in"
                                                Binding="{Binding CheckIn}"/>
                            <DataGridTextColumn Header="Check-out"
                                                Binding="{Binding CheckOut}"/>
                            <DataGridTextColumn Header="Betrag"
                                                Binding="{Binding Amount}"/>
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <!-- Room Status -->
                <GroupBox Grid.Column="1"
                          Header="Zimmerstatus - Uebersicht"
                          FontWeight="Bold"
                          Margin="5,0,0,0">

                    <DataGrid AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Zimmer"
                                                Binding="{Binding RoomNumber}"/>
                            <DataGridTextColumn Header="Typ"
                                                Binding="{Binding Type}"/>
                            <DataGridTextColumn Header="Kap."
                                                Binding="{Binding Capacity}"/>
                            <DataGridTextColumn Header="Preis/Nacht"
                                                Binding="{Binding Price}"/>
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

            </Grid>

        </Grid>
    </Grid>
</UserControl>
