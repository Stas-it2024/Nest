<UserControl x:Class="Nest.Views.Authentication.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cal="http://www.caliburnproject.org"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.45*" />
            <ColumnDefinition Width="0.55*" />
        </Grid.ColumnDefinitions>

        <!-- Linke Panel -->
        <Border Grid.Column="0"
                Background="#234D87">

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <TextBlock Text="Grand&#10;Horizon&#10;Hotel"
                           Foreground="White"
                           FontSize="48"
                           Margin="0,-123,0,0"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Management System"
                           Margin="0,50,0,0"
                           Foreground="#D8E4F5"
                           FontSize="20"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Rechten Panel -->
        <Grid Grid.Column="1"
              Background="#F5F5F5">

            <StackPanel Margin="40"
                        VerticalAlignment="Center" Cursor="">

                <TextBlock Text="Mitarbeiter-Login"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#234D87"
                           Margin="0,20,0,40"/>

                <!-- Benutzername -->
                <TextBlock Text="Benutzername"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <TextBox x:Name="UserNameBox"
                         Loaded="UserNameBox_Loaded"
                         Text="{Binding UserName}"
                         Height="30"
                         FontSize="16"
                         Margin="0,0,0,25"
                         Padding="5,-2,0,0"
                         VerticalContentAlignment="Center"/>

                <!-- Passwort -->
                <TextBlock Text="Passwort"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <Grid>
                    <!-- Passwort versteckt -->
                    <PasswordBox x:Name="PasswordBox"
                                 cal:Message.Attach="[Event PasswordChanged] = [Action SetPassword($source)]"
                                 Visibility="{Binding PasswordBoxVisibility}"
                                 Height="30"
                                 FontSize="16"
                                 Padding="5,-2,0,0"
                                 VerticalContentAlignment="Center"/>

                    <!-- Passwort sichtbar -->
                    <TextBox x:Name="VisiblePasswordBox"
                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding TextBoxVisibility}"
                             Height="30"
                             FontSize="16"
                             Padding="5,-2,0,0"
                             VerticalContentAlignment="Center"/>
                </Grid>

                <CheckBox Content="Passwort anzeigen"
                          IsChecked="{Binding ShowPassword}"
                          Margin="0,15,0,20"
                          FontSize="16"/>

                <!-- Eintrittaste -->
                <Button Content="ANMELDEN"
                        Style="{StaticResource BlueButton}"
                        x:Name="Login"/>

                <!-- Registrieren -->
                <!--<Button Content="Konto erstellen"
                        Style="{StaticResource LinkButton}"
                        Margin="0,10,0,15"/>-->

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,50,0,10">

                    <TextBlock Text="------ GASTBEREICH ------"
                               Foreground="#C0C0C0"
                               FontSize="14"/>

                </StackPanel>

                <!-- Taste für User -->
                <Button Content="Als Gast buchen (Kundenportal)"
                        Style="{StaticResource GreenButton}"
                        x:Name="ShowCustomer"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
