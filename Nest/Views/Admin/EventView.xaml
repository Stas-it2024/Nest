<UserControl x:Class="Nest.Views.Admin.EventView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Nest.Views.Admin"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1000">
    <UserControl.Resources>

        <!-- Label -->
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>

        <!-- Combobox -->
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="10,0,10,10"/>
            <Setter Property="Height" Value="30"/>
        </Style>

        <!-- Button -->
        <Style TargetType="Button">
            <Setter Property="Width" Value="135"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- Button für textbox-->
        <Style x:Key="TextBoxTaste" TargetType="Button">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>
        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="10,0,10,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </UserControl.Resources>
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Background="#224E87" Grid.Row="0" Grid.ColumnSpan="2">
            <TextBlock Text="Eventverwaltung"
                   VerticalAlignment="Center"
                   Margin="25,0"
                   Foreground="White"
                   FontSize="30"
                   FontWeight="Bold"/>
        </Border>
        <ScrollViewer Grid.Row="1" Grid.Column="0"
                  Background="White"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Titel -->
                <Label Grid.Row="0" Grid.Column="0"
                       Content="Titel *"/>
                <TextBox Grid.Column="0" Grid.Row="1"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Datum -->
                <Label Grid.Column="0" Grid.Row="2"
                       Content="Datum *"/>
                <DatePicker Grid.Column="0" Grid.Row="3" 
                            VerticalAlignment="Center" 
                            FontSize="16"
                            Height="30"
                            Margin="10,0,10,10"
                            SelectedDate="{Binding EventDate}"/>

                <!-- Uhrzeit -->
                <Label Grid.Column="0" Grid.Row="4"
                       Content="Uhrzeit *"/>
                
                <Grid Grid.Column="0" Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24*"/>
                        <ColumnDefinition Width="47*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox Grid.ColumnSpan="2"
                             Text="{Binding EventTimeText, UpdateSourceTrigger=PropertyChanged}"/>

                    <StackPanel HorizontalAlignment="Right"
                                Margin="0,3,12,0" 
                                Grid.Column="1">

                        <Button x:Name="PersonUp"
                                Content="▲"
                                Style="{StaticResource TextBoxTaste}"
                                Padding="0"/>

                        <Button Content="▼"
                                x:Name="PersonDown"
                                Style="{StaticResource TextBoxTaste}"
                                Padding="0,-2,0,0"/>

                    </StackPanel>
                </Grid>

                <!-- Ort -->
                <Label Grid.Column="0" Grid.Row="6" 
                       Content="Ort *"/>
                <TextBox Grid.Column="0" Grid.Row="7"
                         Text="{Binding Location,UpdateSourceTrigger=PropertyChanged}"/>
                
                <!-- Preis -->
                <Label Grid.Column="0" Grid.Row="8"
                       Content="Ticket Preis (€)"/>
                
                <Grid Grid.Column="0" Grid.Row="9">
                    <TextBox Width="150" 
                             HorizontalAlignment="Left"
                             Text="{Binding TicketPriceText, UpdateSourceTrigger=PropertyChanged}"/>

                    <StackPanel HorizontalAlignment="Center"
                                Margin="0,3,3,0">

                        <Button x:Name="PreisUp"
                                Content="▲"
                                Style="{StaticResource TextBoxTaste}"
                                Padding="0"/>

                        <Button Content="▼"
                                x:Name="PreisDown"
                                Style="{StaticResource TextBoxTaste}"
                                Padding="0,-2,0,0"/>

                    </StackPanel>
                </Grid>

                <!-- Menge Tickets -->
                <Label Grid.Column="0" Grid.Row="10"
                       Content="Max. Tickets"/>
                
                <Grid Grid.Column="0" Grid.Row="11">
                    <TextBox Width="150" 
                             HorizontalAlignment="Left"
                             Text="{Binding MaxTicketsText, UpdateSourceTrigger=PropertyChanged}"/>

                    <StackPanel HorizontalAlignment="Center"
                                Margin="0,3,3,0">

                        <Button x:Name="MaxUp"
                                Content="▲"
                                Style="{StaticResource TextBoxTaste}"
                                Padding="0"/>

                        <Button Content="▼"
                                x:Name="MinDown"
                                Style="{StaticResource TextBoxTaste}"
                                Padding="0,-2,0,0"/>

                    </StackPanel>
                </Grid>

                <!-- Status -->
                <Label Grid.Column="0" Grid.Row="12"
                       Content="Status *"/>
                
                <ComboBox Grid.Column="0" Grid.Row="13" 
                          VerticalAlignment="Center" 
                          FontSize="16"
                          SelectedIndex="{Binding SelectedStatusIndex}">
                    
                    <ComboBoxItem Content="Aktiv"/>
                    <ComboBoxItem Content="Inaktiv"/>
                    <ComboBoxItem Content="Sold Out"/>
                </ComboBox>

                <!-- Beschreibung -->
                <Label Grid.Column="0" Grid.Row="14"
                       Content="Beschreibung"/>
                
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Grid.Column="0" Grid.Row="15"
                         Height="60" Margin="10,0"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"/>

                <!-- Button -->
                <UniformGrid Grid.Row="16"
                             Rows="2"
                             Columns="2"
                             Margin="10">

                    <Button x:Name="Hinzufügen"
                            Content="Hinzufügen"
                            Background="#28A745"
                            Foreground="White"
                            Margin="0,0,5,5"/>
                    <Button x:Name="Aktualisieren"
                            Content="Aktualisieren"
                            Background="#007ACC"
                            Foreground="White"
                            Margin="5,0,0,5"/>
                    <Button x:Name="Löschen"
                            Content="Löschen"
                            Background="#DC3545"
                            Foreground="White"
                            Margin="0,5,5,0"/>
                    <Button x:Name="ClearForm"
                            Content="Leeren"
                            Background="#6C757D"
                            Foreground="White"
                            Margin="5,5,0,0"/>
                </UniformGrid>

            </Grid>
        </ScrollViewer>


        <DataGrid Style="{StaticResource StandardDataGridStyle}" Grid.Row="1" Grid.Column="1"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding Events}"
                  SelectedItem="{Binding SelectedEvent}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Titel"
                                    Binding="{Binding Title}"
                                    Width="*"
                                   />
                <DataGridTextColumn Header="Datum"
                                    Binding="{Binding EventDate, StringFormat={}{0:dd.MM.yyyy}}"
                                    Width="*"
                                   />
                <DataGridTextColumn Header="Uhrzeit"
                                    Binding="{Binding EventTime}"
                                    Width="*"
                                   />
                <DataGridTextColumn Header="Ort"
                                    Binding="{Binding Location}"
                                    Width="*"
                                   />
                <DataGridTextColumn Header="Ticketpreis"
                                    Binding="{Binding TicketPrice, StringFormat={}{0:F2} €}"
                                    Width="*"
                                   />
                <DataGridTextColumn Header="Tickets"
                                    Binding="{Binding MaxTickets}"
                                    Width="*"
                                   />
                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}" 
                                    Width="Auto"
                                   />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
