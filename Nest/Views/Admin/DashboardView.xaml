<UserControl x:Class="Nest.Views.Admin.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:Nest.Views.Behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Nest.Views.Admin"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="ResponsiveMetricCard" TargetType="Border" BasedOn="{StaticResource DashboardMetricCardStyle}">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="96"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style x:Key="ResponsiveMetricValue" TargetType="TextBlock" BasedOn="{StaticResource DashboardMetricValueStyle}">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="ResponsiveMetricLabel" TargetType="TextBlock" BasedOn="{StaticResource DashboardMetricLabelStyle}">
            <Setter Property="TextWrapping" Value="WrapWithOverflow"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style x:Key="DashboardRoomStatusStyle" TargetType="TextBlock" BasedOn="{StaticResource StandardGridTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Verfuegbar">
                    <Setter Property="Background" Value="#D9EED6"/>
                    <Setter Property="Foreground" Value="#24522A"/>
                </DataTrigger>
                <!-- Last trigger takes precedence over the normal status colors. -->
                <StaticResource ResourceKey="StandardDataGridTextSelectionTrigger"/>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="PageScroller" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto" CanContentScroll="False">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border x:Name="PageHeader" Grid.Row="0" MinHeight="70" Background="{StaticResource PageHeaderBrush}">
            <TextBlock Style="{StaticResource PageHeaderTextStyle}" Text="Übersicht - Gesamtüberblick" TextWrapping="Wrap"/>
        </Border>

        <!-- KPI cards -->
        <WrapPanel x:Name="MetricCards" Grid.Row="1" Margin="4">

            <Border Style="{StaticResource ResponsiveMetricCard}" Background="#2E5A92">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center" Margin="0,4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ResponsiveMetricValue}" Text="{Binding RoomCount}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Style="{StaticResource ResponsiveMetricLabel}" Grid.Row="1" Text="Zimmer Gesamt"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource ResponsiveMetricCard}" Background="Green">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center" Margin="0,4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ResponsiveMetricValue}" Text="{Binding AvailableRoomCount}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Style="{StaticResource ResponsiveMetricLabel}" Grid.Row="1" Text="Verfügbar"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource ResponsiveMetricCard}" Background="#D90000">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center" Margin="0,4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ResponsiveMetricValue}" Text="{Binding OccupiedRoomCount}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Style="{StaticResource ResponsiveMetricLabel}" Grid.Row="1" Text="Belegt"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource ResponsiveMetricCard}" Background="#B8860B">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center" Margin="0,4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ResponsiveMetricValue}" Text="{Binding ReservedRoomCount}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Style="{StaticResource ResponsiveMetricLabel}" Grid.Row="1" Text="Reserviert"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource ResponsiveMetricCard}" Background="#0E75C7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center" Margin="0,4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ResponsiveMetricValue}" Text="{Binding TodayCheckInCount}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Style="{StaticResource ResponsiveMetricLabel}" Grid.Row="1" Text="Heute Check-in"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource ResponsiveMetricCard}" Background="#6A0DAD">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center" Margin="0,4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ResponsiveMetricValue}" Text="{Binding TodayCheckOutCount}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Style="{StaticResource ResponsiveMetricLabel}" Grid.Row="1" Text="Heute Check-out"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource ResponsiveMetricCard}" Background="#0B6B59">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center" Margin="0,4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ResponsiveMetricValue}" Text="{Binding GuestCount}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Style="{StaticResource ResponsiveMetricLabel}" Grid.Row="1" Text="Gäste Gesamt"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource ResponsiveMetricCard}" Background="#2B2B2B">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center" Margin="0,4">
                        <StackPanel>
                            <TextBlock Text="EUR" FontWeight="Bold" FontSize="14" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="RevenueValue" Style="{StaticResource ResponsiveMetricValue}" FontSize="26" Text="{Binding TotalRevenue, StringFormat={}{0:F2}}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Style="{StaticResource ResponsiveMetricLabel}" Grid.Row="1" Text="Gesamtumsatz"/>
                </Grid>
            </Border>
        </WrapPanel>

        <!-- Each table retains its own finite viewport inside the page scroller. -->
        <Grid x:Name="TablesHost" Grid.Row="2" Height="640" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="FirstTableRow" Height="*"/>
                <RowDefinition x:Name="SecondTableRow" Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FirstTableColumn" Width="*"/>
                <ColumnDefinition x:Name="SecondTableColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="ReservationsPanel" Grid.Column="0" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource DashboardSectionHeaderStyle}">
                    <TextBlock Style="{StaticResource DashboardSectionHeadingStyle}" Text="Letzte Reservierungen"/>
                </Border>

                <DataGrid layout:DataGridColumnWidthSession.TableKey="Admin.DashboardView.0" Grid.Row="1" Style="{StaticResource StandardResizableDataGridStyle}" AutoGenerateColumns="False"
                      ItemsSource="{Binding Reservations}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Buchung"
                                        Binding="{Binding ReservationCode}" Width="*" MinWidth="44" layout:DataGridColumnWidthSession.InitialMinWidth="220" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Gast"
                                        Binding="{Binding Guest}" Width="2*" MinWidth="44" layout:DataGridColumnWidthSession.InitialMinWidth="160" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Zimmer"
                                        Binding="{Binding Room}" Width="88" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Typ"
                                        Binding="{Binding Type}" Width="96" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Check-in"
                                        Binding="{Binding CheckInDate}" Width="184" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Check-out"
                                        Binding="{Binding CheckOutDate}" Width="184" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Betrag"
                                        Binding="{Binding TotalAmount}" Width="112" MinWidth="44" ElementStyle="{StaticResource StandardGridNumberStyle}"/>
                        <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}" Width="104" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid x:Name="RoomsPanel" Grid.Row="1" Margin="0,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource DashboardSectionHeaderStyle}">
                    <TextBlock Style="{StaticResource DashboardSectionHeadingStyle}" Text="Zimmerstatus - Übersicht"/>
                </Border>

                <DataGrid layout:DataGridColumnWidthSession.TableKey="Admin.DashboardView.1" Grid.Row="1" Style="{StaticResource StandardResizableDataGridStyle}" AutoGenerateColumns="False"
                      ItemsSource="{Binding Rooms}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Zimmer"
                                        Binding="{Binding RoomNumber}" Width="88" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Typ"
                                        Binding="{Binding Type}" Width="2*" MinWidth="44" layout:DataGridColumnWidthSession.InitialMinWidth="100" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Kapazität"
                                        Binding="{Binding Capacity}" Width="104" MinWidth="44" ElementStyle="{StaticResource StandardGridNumberStyle}"/>
                        <DataGridTextColumn Header="Preis/Nacht"
                                        Binding="{Binding PricePerNight}" Width="120" MinWidth="44" ElementStyle="{StaticResource StandardGridNumberStyle}"/>
                        <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status, Converter={StaticResource GermanValueConverter}, Mode=TwoWay}"
                                        ElementStyle="{StaticResource DashboardRoomStatusStyle}" Width="*" MinWidth="44" layout:DataGridColumnWidthSession.InitialMinWidth="112"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
