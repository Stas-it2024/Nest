<UserControl x:Class="Nest.Views.Admin.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Nest.Views.Admin"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="DashboardColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#224E87"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="BorderBrush" Value="#E6EFF9"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style x:Key="DashboardRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#202D3D"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#B8D1F5"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DashboardCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#B8D1F5"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DashboardRowHeaderStyle" TargetType="DataGridRowHeader">
            <Setter Property="Background" Value="#F0F4F9"/>
            <Setter Property="BorderBrush" Value="#DCE4EE"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRowHeader">
                        <Border x:Name="RowHeaderBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Path x:Name="SelectionArrow" Data="M 0,0 L 8,5 L 0,10 Z"
                                      Fill="Black" Width="8" Height="10" Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsHitTestVisible="False"/>
                                <Thumb x:Name="PART_TopHeaderGripper" Height="3" VerticalAlignment="Top"
                                       Cursor="SizeNS" Opacity="0"/>
                                <Thumb x:Name="PART_BottomHeaderGripper" Height="3" VerticalAlignment="Bottom"
                                       Cursor="SizeNS" Opacity="0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsRowSelected" Value="True">
                                <Setter TargetName="RowHeaderBorder" Property="Background" Value="#2D6FBE"/>
                                <Setter TargetName="SelectionArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DashboardDataGridStyle" TargetType="DataGrid"
               BasedOn="{StaticResource StandardDataGridStyle}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#202D3D"/>
            <Setter Property="RowHeaderWidth" Value="40"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="ColumnHeaderHeight" Value="30"/>
            <Setter Property="HeadersVisibility" Value="All"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E1E7EF"/>
            <Setter Property="BorderBrush" Value="#D5DFEB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource DashboardColumnHeaderStyle}"/>
            <Setter Property="RowStyle" Value="{StaticResource DashboardRowStyle}"/>
            <Setter Property="CellStyle" Value="{StaticResource DashboardCellStyle}"/>
            <Setter Property="RowHeaderStyle" Value="{StaticResource DashboardRowHeaderStyle}"/>
        </Style>
        <Style x:Key="DashboardRoomStatusStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="4,2"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="Verfuegbar">
                    <Setter Property="Background" Value="#D9EED6"/>
                    <Setter Property="Foreground" Value="#24522A"/>
                </Trigger>
                <Trigger Property="Text" Value="Available">
                    <Setter Property="Background" Value="#D9EED6"/>
                    <Setter Property="Foreground" Value="#24522A"/>
                </Trigger>
                <!-- Last trigger takes precedence over the normal status colors. -->
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Background" Value="#B8D1F5"/>
                    <Setter Property="Foreground" Value="Black"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Height="70" Background="#224E87">
            <TextBlock Text="Dashboard - Gesamtueberblick"
                       VerticalAlignment="Center"
                       Margin="25,0"
                       Foreground="White"
                       FontSize="30"
                       FontWeight="Bold"/>
        </Border>

        <!-- KPI cards -->
        <Grid Grid.Row="1" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#2E5A92" Margin="2,0" Height="125" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,4">
                        <StackPanel>
                            <TextBlock Text="{Binding RoomCount}" FontSize="40" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                    <TextBlock Grid.Row="1" Text="Zimmer Gesamt" FontSize="12" Foreground="White"
                               TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="Green" Margin="2,0" Height="125" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,4">
                        <StackPanel>
                            <TextBlock Text="{Binding AvailableRoomCount}" FontSize="40" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                    <TextBlock Grid.Row="1" Text="Verfügbar" FontSize="12" Foreground="White"
                               TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#D90000" Margin="2,0" Height="125" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,4">
                        <StackPanel>
                            <TextBlock Text="{Binding OccupiedRoomCount}" FontSize="40" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                    <TextBlock Grid.Row="1" Text="Belegt" FontSize="12" Foreground="White"
                               TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="3" Background="#B8860B" Margin="2,0" Height="125" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,4">
                        <StackPanel>
                            <TextBlock Text="{Binding ReservedRoomCount}" FontSize="40" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                    <TextBlock Grid.Row="1" Text="Reserviert" FontSize="12" Foreground="White"
                               TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="#0E75C7" Margin="2,0" Height="125" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,4">
                        <StackPanel>
                            <TextBlock Text="{Binding TodayCheckInCount}" FontSize="40" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                    <TextBlock Grid.Row="1" Text="Heute Check-in" FontSize="12" Foreground="White"
                               TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="5" Background="#6A0DAD" Margin="2,0" Height="125" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,4">
                        <StackPanel>
                            <TextBlock Text="{Binding TodayCheckOutCount}" FontSize="40" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                    <TextBlock Grid.Row="1" Text="Heute Check-out" FontSize="12" Foreground="White"
                               TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="6" Background="#0B6B59" Margin="2,0" Height="125" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,4">
                        <StackPanel>
                            <TextBlock Text="{Binding GuestCount}" FontSize="40" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                    <TextBlock Grid.Row="1" Text="Gäste Gesamt" FontSize="12" Foreground="White"
                               TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="7" Background="#2B2B2B" Margin="2,0" Height="125" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="EUR" Margin="0,0,6,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="30" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:F2}}" FontSize="40" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                    <TextBlock Grid.Row="1" Text="Gesamtumsatz" FontSize="12" Foreground="White"
                               TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Tables -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,2,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#E4EFFA" Padding="8,5">
                    <TextBlock Text="Letzte Reservierungen" Foreground="#224E87" FontSize="16"
                               FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                </Border>

                <DataGrid Grid.Row="1" Style="{StaticResource DashboardDataGridStyle}" AutoGenerateColumns="False"
                      ItemsSource="{Binding Reservations}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="1.2*" Header="Buchung"
                                        Binding="{Binding ReservationCode}"/>
                        <DataGridTextColumn Width="1.2*" Header="Gast"
                                        Binding="{Binding Guest}"/>
                        <DataGridTextColumn Width="0.8*" Header="Zimmer"
                                        Binding="{Binding Room}"/>
                        <DataGridTextColumn Width="0.8*" Header="Typ"
                                        Binding="{Binding Type}"/>
                        <DataGridTextColumn Width="1.1*" Header="Check-in"
                                        Binding="{Binding CheckInDate}"/>
                        <DataGridTextColumn Width="1.1*" Header="Check-out"
                                        Binding="{Binding CheckOutDate}"/>
                        <DataGridTextColumn Width="0.9*" Header="Betrag"
                                        Binding="{Binding TotalAmount}"/>
                        <DataGridTextColumn Width="1*" Header="Status"
                                        Binding="{Binding Status}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Column="1" Margin="2,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#E4EFFA" Padding="8,5">
                    <TextBlock Text="Zimmerstatus - Übersicht" Foreground="#224E87" FontSize="16"
                               FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                </Border>

                <DataGrid Grid.Row="1" Style="{StaticResource DashboardDataGridStyle}" AutoGenerateColumns="False"
                      ItemsSource="{Binding Rooms}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="0.9*" Header="Zimmer"
                                        Binding="{Binding RoomNumber}"/>
                        <DataGridTextColumn Width="1.1*" Header="Typ"
                                        Binding="{Binding Type}"/>
                        <DataGridTextColumn Width="0.7*" Header="Kapazität"
                                        Binding="{Binding Capacity}"/>
                        <DataGridTextColumn Width="1.3*" Header="Preis/Nacht"
                                        Binding="{Binding PricePerNight}"/>
                        <DataGridTextColumn Width="1.2*" Header="Status"
                                        Binding="{Binding Status}"
                                        ElementStyle="{StaticResource DashboardRoomStatusStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
