<UserControl x:Class="Nest.Views.Admin.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:Nest.Views.Behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Nest.Views.Admin"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="DashboardRoomStatusStyle" TargetType="TextBlock" BasedOn="{StaticResource StandardGridTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Verfuegbar">
                    <Setter Property="Background" Value="#D9EED6"/>
                    <Setter Property="Foreground" Value="#24522A"/>
                </DataTrigger>
                <!-- Last trigger takes precedence over the normal status colors. -->
                <StaticResource ResourceKey="StandardDataGridTextSelectionTrigger"/>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Height="70" Background="{StaticResource PageHeaderBrush}">
            <TextBlock Style="{StaticResource PageHeaderTextStyle}" Text="Übersicht - Gesamtüberblick"/>
        </Border>

        <!-- KPI cards -->
        <Grid Grid.Row="1" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource DashboardMetricCardStyle}" Grid.Column="0" Background="#2E5A92">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DashboardMetricValueStyle}" Text="{Binding RoomCount}"/>
                        </StackPanel>
                    </Viewbox>
                    <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Grid.Row="1" Text="Zimmer Gesamt"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardMetricCardStyle}" Grid.Column="1" Background="Green">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DashboardMetricValueStyle}" Text="{Binding AvailableRoomCount}"/>
                        </StackPanel>
                    </Viewbox>
                    <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Grid.Row="1" Text="Verfügbar"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardMetricCardStyle}" Grid.Column="2" Background="#D90000">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DashboardMetricValueStyle}" Text="{Binding OccupiedRoomCount}"/>
                        </StackPanel>
                    </Viewbox>
                    <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Grid.Row="1" Text="Belegt"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardMetricCardStyle}" Grid.Column="3" Background="#B8860B">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DashboardMetricValueStyle}" Text="{Binding ReservedRoomCount}"/>
                        </StackPanel>
                    </Viewbox>
                    <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Grid.Row="1" Text="Reserviert"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardMetricCardStyle}" Grid.Column="4" Background="#0E75C7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DashboardMetricValueStyle}" Text="{Binding TodayCheckInCount}"/>
                        </StackPanel>
                    </Viewbox>
                    <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Grid.Row="1" Text="Heute Check-in"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardMetricCardStyle}" Grid.Column="5" Background="#6A0DAD">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DashboardMetricValueStyle}" Text="{Binding TodayCheckOutCount}"/>
                        </StackPanel>
                    </Viewbox>
                    <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Grid.Row="1" Text="Heute Check-out"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardMetricCardStyle}" Grid.Column="6" Background="#0B6B59">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DashboardMetricValueStyle}" Text="{Binding GuestCount}"/>
                        </StackPanel>
                    </Viewbox>
                    <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Grid.Row="1" Text="Gäste Gesamt"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardMetricCardStyle}" Grid.Column="7" Background="#2B2B2B">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="EUR" Margin="0,0,6,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="30" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Style="{StaticResource DashboardMetricValueStyle}" Text="{Binding TotalRevenue, StringFormat={}{0:F2}}"/>
                        </StackPanel>
                    </Viewbox>
                    <TextBlock Style="{StaticResource DashboardMetricLabelStyle}" Grid.Row="1" Text="Gesamtumsatz"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Tables -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,2,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource DashboardSectionHeaderStyle}">
                    <TextBlock Style="{StaticResource DashboardSectionHeadingStyle}" Text="Letzte Reservierungen"/>
                </Border>

                <DataGrid layout:DataGridColumnWidthSession.TableKey="Admin.DashboardView.0" Grid.Row="1" Style="{StaticResource StandardResizableDataGridStyle}" AutoGenerateColumns="False"
                      ItemsSource="{Binding Reservations}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Buchung"
                                        Binding="{Binding ReservationCode}" Width="*" MinWidth="44" layout:DataGridColumnWidthSession.InitialMinWidth="220" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Gast"
                                        Binding="{Binding Guest}" Width="2*" MinWidth="44" layout:DataGridColumnWidthSession.InitialMinWidth="160" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Zimmer"
                                        Binding="{Binding Room}" Width="88" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Typ"
                                        Binding="{Binding Type}" Width="96" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Check-in"
                                        Binding="{Binding CheckInDate}" Width="184" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Check-out"
                                        Binding="{Binding CheckOutDate}" Width="184" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Betrag"
                                        Binding="{Binding TotalAmount}" Width="112" MinWidth="44" ElementStyle="{StaticResource StandardGridNumberStyle}"/>
                        <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}" Width="104" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Column="1" Margin="2,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource DashboardSectionHeaderStyle}">
                    <TextBlock Style="{StaticResource DashboardSectionHeadingStyle}" Text="Zimmerstatus - Übersicht"/>
                </Border>

                <DataGrid layout:DataGridColumnWidthSession.TableKey="Admin.DashboardView.1" Grid.Row="1" Style="{StaticResource StandardResizableDataGridStyle}" AutoGenerateColumns="False"
                      ItemsSource="{Binding Rooms}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Zimmer"
                                        Binding="{Binding RoomNumber}" Width="88" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Typ"
                                        Binding="{Binding Type}" Width="2*" MinWidth="44" layout:DataGridColumnWidthSession.InitialMinWidth="100" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Kapazität"
                                        Binding="{Binding Capacity}" Width="104" MinWidth="44" ElementStyle="{StaticResource StandardGridNumberStyle}"/>
                        <DataGridTextColumn Header="Preis/Nacht"
                                        Binding="{Binding PricePerNight}" Width="120" MinWidth="44" ElementStyle="{StaticResource StandardGridNumberStyle}"/>
                        <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status, Converter={StaticResource GermanValueConverter}, Mode=TwoWay}"
                                        ElementStyle="{StaticResource DashboardRoomStatusStyle}" Width="*" MinWidth="44" layout:DataGridColumnWidthSession.InitialMinWidth="112"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
