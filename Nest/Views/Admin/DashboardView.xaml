<UserControl x:Class="Nest.Views.Admin.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Nest.Views.Admin"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <!-- MAIN CONTENT -->
    <Grid Grid.Column="1">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="130"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#224E87">
            <TextBlock Text="Dashboard - Gesamtuebersicht"
                   VerticalAlignment="Center"
                   Margin="25,0"
                   Foreground="White"
                   FontSize="30"
                   FontWeight="Bold"/>
        </Border>

        <!-- Statistics -->
        <UniformGrid Grid.Row="1"
                 Columns="8"
                 Margin="10">

            <Border Background="#2E5A92" Margin="5">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding RoomCount}"
                           FontSize="40"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                    <TextBlock Text="Zimmer Gesamt"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="Green" Margin="5">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding AvailableRoomCount}"
                           FontSize="40"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                    <TextBlock Text="Verfügbar"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="#D90000" Margin="5">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding OccupiedRoomCount}"
                           FontSize="40"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                    <TextBlock Text="Belegt"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="#B8860B" Margin="5">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ReservedRoomCount}"
                           FontSize="40"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                    <TextBlock Text="Reserviert"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="#0E75C7" Margin="5">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding TodayCheckInCount}"
                           FontSize="40"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                    <TextBlock Text="Heute Check-in"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="#6A0DAD" Margin="5">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding TodayCheckOutCount}"
                           FontSize="40"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                    <TextBlock Text="Heute Check-out"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="#0B6B59" Margin="5">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding GuestCount}"
                           FontSize="40"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                    <TextBlock Text="Gaeste Gesamt"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="#2B2B2B" Margin="5">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="EUR"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:F2}}"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                    <TextBlock Text="Gesamtumsatz"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <!-- Tables -->
        <Grid Grid.Row="2" Margin="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Reservations -->
            <GroupBox Header="Letzte Reservierungen"
                  Margin="0,0,5,0">

                <DataGrid AutoGenerateColumns="False"
                      ItemsSource="{Binding Reservations}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Buchung"
                                        Binding="{Binding ReservationCode}"/>
                        <DataGridTextColumn Header="Gast"
                                        Binding="{Binding Guest}"/>
                        <DataGridTextColumn Header="Zimmer"
                                        Binding="{Binding Room}"/>
                        <DataGridTextColumn Header="Typ"
                                        Binding="{Binding Type}"/>
                        <DataGridTextColumn Header="Check-in"
                                        Binding="{Binding CheckInDate}"/>
                        <DataGridTextColumn Header="Check-out"
                                        Binding="{Binding CheckOutDate}"/>
                        <DataGridTextColumn Header="Betrag"
                                        Binding="{Binding TotalAmount}"/>
                        <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Room Status -->
            <GroupBox Grid.Column="1"
                  Header="Zimmerstatus - Uebersicht"
                  FontWeight="Bold"
                  Margin="5,0,0,0">

                <DataGrid AutoGenerateColumns="False" 
                      ItemsSource="{Binding Rooms}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Zimmer"
                                        Binding="{Binding RoomNumber}"/>
                        <DataGridTextColumn Header="Typ"
                                        Binding="{Binding Type}"/>
                        <DataGridTextColumn Header="Kapazität"
                                        Binding="{Binding Capacity}"/>
                        <DataGridTextColumn Header="Preis/Nacht"
                                        Binding="{Binding PricePerNight}"/>
                        <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

        </Grid>

    </Grid>
</UserControl>
