<UserControl x:Class="Nest.Views.Admin.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Nest.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <UserControl.Resources>
        <converters:SectionBackgroundConverter x:Key="SectionBackgroundConverter"/>

        <!-- Gemeinsamer Stil für alle Buttons -->
        <Style x:Key="BaseButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarMenuButtonBaseStyle}"/>

        <!-- Stil für Menu-Buttons -->
        <Style x:Key="MenuButtonStyle" TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Margin="{TemplateBinding Padding}"
                                RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#214676"/>
                            </Trigger>

                            <!-- Pressed -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#122C4D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT MENU -->
        <Border Grid.Column="0" Background="{StaticResource StaffSidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Margin="10,20">
                    <TextBlock Style="{StaticResource StaffBrandTextStyle}" Text="Grand Horizon"/>

                    <TextBlock Style="{StaticResource StaffHotelTextStyle}" Text="Hotel"/>

                    <Separator Margin="0,15"/>

                    <TextBlock Style="{StaticResource StaffInfoTextStyle}" Text="Systemadministrator"/>

                    <TextBlock Style="{StaticResource StaffInfoTextStyle}" Text="(Admin)"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1">

                    <Button x:Name="ShowDashboard"
                            Tag="Dashboard"
                            Content="Übersicht"
                            Style="{StaticResource MenuButtonStyle}"
                            Background="{Binding SelectedSection, Converter={StaticResource SectionBackgroundConverter}, ConverterParameter=Dashboard}"/>

                    <Button x:Name="ShowZimmer"
                            Tag="Zimmer"
                            Content="Zimmer"
                            Style="{StaticResource MenuButtonStyle}"
                            Background="{Binding SelectedSection, Converter={StaticResource SectionBackgroundConverter}, ConverterParameter=Zimmer}"/>

                    <Button x:Name="ShowBenutzer"
                            Tag="Benutzer"
                            Content="Benutzer"
                            Style="{StaticResource MenuButtonStyle}"
                            Background="{Binding SelectedSection, Converter={StaticResource SectionBackgroundConverter}, ConverterParameter=Benutzer}"/>

                    <Button x:Name="ShowDienstleistungen"
                            Tag="Dienstleistungen"
                            Content="Dienstleistungen"
                            Style="{StaticResource MenuButtonStyle}"
                            Background="{Binding SelectedSection, Converter={StaticResource SectionBackgroundConverter}, ConverterParameter=Dienstleistungen}"/>

                    <Button x:Name="ShowEvents"
                            Tag="Events"
                            Content="Veranstaltungen"
                            Style="{StaticResource MenuButtonStyle}"
                            Background="{Binding SelectedSection, Converter={StaticResource SectionBackgroundConverter}, ConverterParameter=Events}"/>

                    <Button x:Name="ShowAlleReservierungen"
                            Tag="AlleReservierungen"
                            Content="Alle Reservierungen"
                            Style="{StaticResource MenuButtonStyle}"
                            Background="{Binding SelectedSection, Converter={StaticResource SectionBackgroundConverter}, ConverterParameter=AlleReservierungen}"/>
                </StackPanel>

                <!-- Bottom buttons -->
                <StackPanel Grid.Row="2" Margin="0" Background="#0F284B">
                    <Button Content="Abmelden"
                            Style="{StaticResource AdminLogoutButtonStyle}"
                            x:Name="Abmelden"/>

                    <Button Content="Beenden"
                            Style="{StaticResource AdminExitButtonStyle}"
                            x:Name="Beenden"/>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl x:Name="ActiveItem" Grid.Column="1"/>
    </Grid>
</UserControl>

 
