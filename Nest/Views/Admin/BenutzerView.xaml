<UserControl x:Class="Nest.Views.Admin.BenutzerView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 

             xmlns:local="clr-namespace:Nest.Views.Admin"

             mc:Ignorable="d" 

             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>

        <!-- Label -->
        <Style TargetType="Label" BasedOn="{StaticResource AdminFormLabelStyle}"/>

        <!-- Combobox -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource AdminFormComboBoxStyle}"/>


        <!-- TextBox -->
        <Style TargetType="TextBox" BasedOn="{StaticResource AdminFormTextBoxStyle}"/>
    </UserControl.Resources>
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Background="{StaticResource PageHeaderBrush}" Grid.Row="0" Grid.ColumnSpan="2">
            <TextBlock Style="{StaticResource PageHeaderTextStyle}" Text="Benutzerverwaltung"/>
        </Border>
        <ScrollViewer Grid.Row="1" Grid.Column="0"

                  Background="White"

                  VerticalScrollBarVisibility="Auto"

                  HorizontalScrollBarVisibility="Disabled">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Benutzername -->
                <Label Grid.Row="0" Grid.Column="0"

                       Content="Benutzername *"/>
                <TextBox Grid.Column="0" Grid.Row="1"

                         Text="{Binding UserName}"/>

                <!-- Volständiger Name -->
                <Label Grid.Column="0" Grid.Row="2"

                       Content="Volständiger Name *"/>
                <TextBox Grid.Column="0" Grid.Row="3" 

                         Text="{Binding FullName}"/>

                <!-- Passwort -->
                <Label Grid.Column="0" Grid.Row="4"

                       Content="Passwort (leer = unverändert)"/>
                <TextBox Grid.Column="0" Grid.Row="5" 

                         Text="{Binding Password}"/>

                <!-- Rolle -->
                <Label Grid.Column="0" Grid.Row="6"

                       Content="Rolle *"/>
                <ComboBox Grid.Column="0" Grid.Row="7" 

                          VerticalAlignment="Center" 

                          FontSize="16"

                          SelectedValue="{Binding Role}"

                          SelectedValuePath="Content">
                    <ComboBoxItem Content="Rezeptionist"/>
                    <ComboBoxItem Content="Admin"/>
                </ComboBox>

                <!-- Status -->
                <Label Grid.Column="0" Grid.Row="8"

                       Content="Status *"/>
                <ComboBox Grid.Column="0" Grid.Row="9" 

                          VerticalAlignment="Center" 

                          FontSize="16"

                          SelectedValue="{Binding Status}"

                          SelectedValuePath="Content">
                    <ComboBoxItem Content="Aktiv"/>
                    <ComboBoxItem Content="Inaktiv"/>
                </ComboBox>


                <!-- Button -->
                <UniformGrid Grid.Row="12"

                         Rows="2"

                         Columns="2"

                         Margin="10">

                    <Button x:Name="Hinzufügen"

                        Content="Hinzufügen"

                        Style="{StaticResource SuccessButtonStyle}" Width="135" Padding="10"

                        Margin="0,0,5,5"/>
                    <Button x:Name="Aktualisieren"

                        Content="Aktualisieren"

                        Style="{StaticResource PrimaryButtonStyle}" Width="135" Padding="10"

                        Margin="5,0,0,5"/>
                    <Button x:Name="Löschen"

                        Content="Löschen"

                        Style="{StaticResource DangerButtonStyle}" Width="135" Padding="10"

                        Margin="0,5,5,0"/>
                    <Button x:Name="ClearForm"

                        Content="Leeren"

                        Style="{StaticResource SecondaryButtonStyle}" Width="135" Padding="10"

                        Margin="5,5,0,0"/>
                </UniformGrid>

            </Grid>
        </ScrollViewer>


        <DataGrid Style="{StaticResource StandardDataGridStyle}" Grid.Row="1" Grid.Column="1"

                  ItemsSource="{Binding Users}"

                  SelectedItem="{Binding SelectedUser}"

                  AutoGenerateColumns="False">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Benutzername"

                                    Binding="{Binding UserName}"

                                    Width="*"

                                   />
                <DataGridTextColumn Header="Name"

                                    Binding="{Binding FullName}"

                                    Width="*"

                                   />
                <DataGridTextColumn Header="Rolle"

                                    Binding="{Binding Role}"

                                    Width="*"

                                   />
                <DataGridTextColumn Header="Status"

                                    Binding="{Binding Status}"

                                    Width="*"

                                   />
                <DataGridTextColumn Header="Erstellt"

                                    Binding="{Binding DateAdded, StringFormat={}{0:dd.MM.yyyy}}"

                                Width="Auto"

                               />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

 
