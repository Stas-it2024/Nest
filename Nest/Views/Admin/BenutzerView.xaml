<UserControl x:Class="Nest.Views.Admin.BenutzerView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 

             xmlns:local="clr-namespace:Nest.Views.Admin"

             mc:Ignorable="d" 

             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>

        <!-- Label -->
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>

        <!-- Combobox -->
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="10,0,10,10"/>
            <Setter Property="Height" Value="30"/>
        </Style>

        <!-- Button -->
        <Style TargetType="Button">
            <Setter Property="Width" Value="135"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- Button für textbox-->
        <Style x:Key="TextBoxTaste" TargetType="Button">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>
        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="10,0,10,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </UserControl.Resources>
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Background="#224E87" Grid.Row="0" Grid.ColumnSpan="2">
            <TextBlock Text="Benutzerverwaltung"

                   VerticalAlignment="Center"

                   Margin="25,0"

                   Foreground="White"

                   FontSize="30"

                   FontWeight="Bold"/>
        </Border>
        <ScrollViewer Grid.Row="1" Grid.Column="0"

                  Background="White"

                  VerticalScrollBarVisibility="Auto"

                  HorizontalScrollBarVisibility="Disabled">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Benutzername -->
                <Label Grid.Row="0" Grid.Column="0"

                       Content="Benutzername *"/>
                <TextBox Grid.Column="0" Grid.Row="1"

                         Text="{Binding UserName}"/>

                <!-- Volständiger Name -->
                <Label Grid.Column="0" Grid.Row="2"

                       Content="Volständiger Name *"/>
                <TextBox Grid.Column="0" Grid.Row="3" 

                         Text="{Binding FullName}"/>

                <!-- Passwort -->
                <Label Grid.Column="0" Grid.Row="4"

                       Content="Passwort (leer = unverändert)"/>
                <TextBox Grid.Column="0" Grid.Row="5" 

                         Text="{Binding Password}"/>

                <!-- Rolle -->
                <Label Grid.Column="0" Grid.Row="6"

                       Content="Rolle *"/>
                <ComboBox Grid.Column="0" Grid.Row="7" 

                          VerticalAlignment="Center" 

                          FontSize="16"

                          SelectedValue="{Binding Role}"

                          SelectedValuePath="Content">
                    <ComboBoxItem Content="Rezeptionist"/>
                    <ComboBoxItem Content="Admin"/>
                </ComboBox>

                <!-- Status -->
                <Label Grid.Column="0" Grid.Row="8"

                       Content="Status *"/>
                <ComboBox Grid.Column="0" Grid.Row="9" 

                          VerticalAlignment="Center" 

                          FontSize="16"

                          SelectedValue="{Binding Status}"

                          SelectedValuePath="Content">
                    <ComboBoxItem Content="Aktiv"/>
                    <ComboBoxItem Content="Inaktiv"/>
                </ComboBox>


                <!-- Button -->
                <UniformGrid Grid.Row="12"

                         Rows="2"

                         Columns="2"

                         Margin="10">

                    <Button x:Name="Hinzufügen"

                        Content="Hinzufügen"

                        Background="#28A745"

                        Foreground="White"

                        Margin="0,0,5,5"/>
                    <Button x:Name="Aktualisieren"

                        Content="Aktualisieren"

                        Background="#007ACC"

                        Foreground="White"

                        Margin="5,0,0,5"/>
                    <Button x:Name="Löschen"

                        Content="Löschen"

                        Background="#DC3545"

                        Foreground="White"

                        Margin="0,5,5,0"/>
                    <Button x:Name="ClearForm"

                        Content="Leeren"

                        Background="#6C757D"

                        Foreground="White"

                        Margin="5,5,0,0"/>
                </UniformGrid>

            </Grid>
        </ScrollViewer>


        <DataGrid Style="{StaticResource StandardDataGridStyle}" Grid.Row="1" Grid.Column="1"

                  ItemsSource="{Binding Users}"

                  SelectedItem="{Binding SelectedUser}"

                  AutoGenerateColumns="False">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Benutzername"

                                    Binding="{Binding UserName}"

                                    Width="*"

                                   />
                <DataGridTextColumn Header="Name"

                                    Binding="{Binding FullName}"

                                    Width="*"

                                   />
                <DataGridTextColumn Header="Rolle"

                                    Binding="{Binding Role}"

                                    Width="*"

                                   />
                <DataGridTextColumn Header="Status"

                                    Binding="{Binding Status}"

                                    Width="*"

                                   />
                <DataGridTextColumn Header="Erstellt"

                                    Binding="{Binding DateAdded, StringFormat={}{0:dd.MM.yyyy}}"

                                Width="Auto"

                               />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

 
