<UserControl x:Class="Nest.Views.Admin.DienstleistungView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:Nest.Views.Behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Nest.Views.Admin"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>

        <!-- Label -->
        <Style TargetType="Label" BasedOn="{StaticResource AdminFormLabelStyle}"/>

        <!-- Combobox -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource AdminFormComboBoxStyle}"/>


        <!-- TextBox -->
        <Style TargetType="TextBox" BasedOn="{StaticResource AdminFormTextBoxStyle}"/>
    </UserControl.Resources>
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Background="{StaticResource PageHeaderBrush}" Grid.Row="0" Grid.ColumnSpan="2">
            <TextBlock Style="{StaticResource PageHeaderTextStyle}" Text="Dienstleistungsverwaltung"/>
        </Border>
        <ScrollViewer Grid.Row="1" Grid.Column="0"
                  Background="White"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Name der Diensleistung -->
                <Label Grid.Row="0" Grid.Column="0"
                       Content="Name der Dienstleistung *"/>
                <TextBox Grid.Column="0" Grid.Row="1"
                         Text="{Binding ServiceName, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Kategorie -->
                <Label Grid.Column="0" Grid.Row="2"
                       Content="Kategorie *"/>
                <ComboBox Grid.Column="0" Grid.Row="3" 
                          VerticalAlignment="Center" 
                          FontSize="16"
                          SelectedIndex="{Binding SelectedCategoryIndex}">
                    <ComboBoxItem Content="Speisen und Getränke"/>
                    <ComboBoxItem Content="Wäsche"/>
                    <ComboBoxItem Content="Wellness"/>
                    <ComboBoxItem Content="Transport"/>
                    <ComboBoxItem Content="Sonstiges"/>
                </ComboBox>

                <!-- Preis -->
                <Label Grid.Column="0" Grid.Row="6"
                       Content="Preis (€)*"/>
                <Grid Grid.Column="0" Grid.Row="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="83*"/>
                        <ColumnDefinition Width="17*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Width="150" 
                             HorizontalAlignment="Left"
                             Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,10"/>

                    <StackPanel HorizontalAlignment="Left"
                                Margin="141,3,0,0">

                        <Button x:Name="PreisUp"
                                Content="▲"
                                Style="{StaticResource TextBoxTaste}"
                                Padding="0"/>

                        <Button Content="▼"
                                x:Name="PreisDown"
                                Style="{StaticResource TextBoxTaste}"
                                Padding="0,-2,0,0"/>

                    </StackPanel>
                </Grid>

                <!-- Status -->
                <Label Grid.Column="0" Grid.Row="8"
                       Content="Status *"/>
                <ComboBox Grid.Column="0" Grid.Row="9" 
                          VerticalAlignment="Center" 
                          FontSize="16"
                          SelectedIndex="{Binding SelectedStatusIndex}">
                    <ComboBoxItem Content="Verfügbar"/>
                    <ComboBoxItem Content="Nicht verfügbar"/>
                </ComboBox>

                <!-- Button -->
                <UniformGrid Grid.Row="12"
                             Rows="2"
                             Columns="2"
                             Margin="10">

                    <Button x:Name="Hinzufügen"
                            Content="Hinzufügen"
                            Style="{StaticResource SuccessButtonStyle}" Width="135" Padding="10"
                            Margin="0,0,5,5"/>
                    <Button x:Name="Aktualisieren"
                            Content="Aktualisieren"
                            Style="{StaticResource PrimaryButtonStyle}" Width="135" Padding="10"
                            Margin="5,0,0,5"/>
                    <Button x:Name="Löschen"
                            Content="Löschen"
                            Style="{StaticResource DangerButtonStyle}" Width="135" Padding="10"
                            Margin="0,5,5,0"/>
                    <Button x:Name="ClearForm"
                            Content="Leeren"
                            Style="{StaticResource SecondaryButtonStyle}" Width="135" Padding="10"
                            Margin="5,5,0,0"/>
                </UniformGrid>

            </Grid>
        </ScrollViewer>


        <DataGrid layout:DataGridColumnWidthSession.TableKey="Admin.DienstleistungView.0" Style="{StaticResource StandardResizableDataGridStyle}" Grid.Row="1" Grid.Column="1"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding Services}"
                  SelectedItem="{Binding SelectedService}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Dienstleistung"
                                    Binding="{Binding ServiceName}"
                                    Width="2*" MinWidth="44" layout:DataGridColumnWidthSession.InitialMinWidth="180" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                <DataGridTextColumn Header="Kategorie"
                                    Binding="{Binding CategoryDisplay}"
                                    Width="*" MinWidth="44" layout:DataGridColumnWidthSession.InitialMinWidth="184" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                <DataGridTextColumn Header="Preis (EUR)"
                                    Binding="{Binding Price, StringFormat={}{0:F2} €}"
                                    Width="120" MinWidth="44" ElementStyle="{StaticResource StandardGridNumberStyle}"/>
                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status, Converter={StaticResource GermanValueConverter}, Mode=TwoWay}"
                                    Width="144" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
