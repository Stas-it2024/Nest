<UserControl x:Class="Nest.Views.Admin.DienstleistungView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Nest.Views.Admin"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>

        <!-- Label -->
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>

        <!-- Combobox -->
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="10,0,10,10"/>
            <Setter Property="Height" Value="30"/>
        </Style>

        <!-- Button -->
        <Style TargetType="Button">
            <Setter Property="Width" Value="135"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- Button für textbox-->
        <Style x:Key="TextBoxTaste" TargetType="Button">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>
        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="10,0,10,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </UserControl.Resources>
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Background="#224E87" Grid.Row="0" Grid.ColumnSpan="2">
            <TextBlock Text="Diensleistungsverwaltung"
                   VerticalAlignment="Center"
                   Margin="25,0"
                   Foreground="White"
                   FontSize="30"
                   FontWeight="Bold"/>
        </Border>
        <ScrollViewer Grid.Row="1" Grid.Column="0"
                  Background="White"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Name der Diensleistung -->
                <Label Grid.Row="0" Grid.Column="0"
                       Content="Name der Diensleistung *"/>
                <TextBox Grid.Column="0" Grid.Row="1"
                         Text="{Binding ServiceName, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Kategorie -->
                <Label Grid.Column="0" Grid.Row="2"
                       Content="Kategorie *"/>
                <ComboBox Grid.Column="0" Grid.Row="3" 
                          VerticalAlignment="Center" 
                          FontSize="16"
                          SelectedIndex="{Binding SelectedCategoryIndex}">
                    <ComboBoxItem Content="Speisen und Getränke"/>
                    <ComboBoxItem Content="Wäsche"/>
                    <ComboBoxItem Content="Spa"/>
                    <ComboBoxItem Content="Transport"/>
                    <ComboBoxItem Content="Sonstiges"/>
                </ComboBox>

                <!-- Preis -->
                <Label Grid.Column="0" Grid.Row="6"
                       Content="Preis (€)*"/>
                <Grid Grid.Column="0" Grid.Row="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="83*"/>
                        <ColumnDefinition Width="17*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Width="150" 
                             HorizontalAlignment="Left"
                             Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,10"/>

                    <StackPanel HorizontalAlignment="Left"
                                Margin="141,3,0,0">

                        <Button x:Name="PreisUp"
                                Content="▲"
                                Style="{StaticResource TextBoxTaste}"
                                Padding="0"/>

                        <Button Content="▼"
                                x:Name="PreisDown"
                                Style="{StaticResource TextBoxTaste}"
                                Padding="0,-2,0,0"/>

                    </StackPanel>
                </Grid>

                <!-- Status -->
                <Label Grid.Column="0" Grid.Row="8"
                       Content="Status *"/>
                <ComboBox Grid.Column="0" Grid.Row="9" 
                          VerticalAlignment="Center" 
                          FontSize="16"
                          SelectedIndex="{Binding SelectedStatusIndex}">
                    <ComboBoxItem Content="Verfuegbar"/>
                    <ComboBoxItem Content="Nicht_verfuegbar"/>
                </ComboBox>

                <!-- Button -->
                <UniformGrid Grid.Row="12"
                             Rows="2"
                             Columns="2"
                             Margin="10">

                    <Button x:Name="Hinzufügen"
                            Content="Hinzufügen"
                            Background="#28A745"
                            Foreground="White"
                            Margin="0,0,5,5"/>
                    <Button x:Name="Aktualisieren"
                            Content="Aktualisieren"
                            Background="#007ACC"
                            Foreground="White"
                            Margin="5,0,0,5"/>
                    <Button x:Name="Löschen"
                            Content="Löschen"
                            Background="#DC3545"
                            Foreground="White"
                            Margin="0,5,5,0"/>
                    <Button x:Name="ClearForm"
                            Content="Leeren"
                            Background="#6C757D"
                            Foreground="White"
                            Margin="5,5,0,0"/>
                </UniformGrid>

            </Grid>
        </ScrollViewer>


        <DataGrid Style="{StaticResource StandardDataGridStyle}" Grid.Row="1" Grid.Column="1"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding Services}"
                  SelectedItem="{Binding SelectedService}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Diensleistung"
                                    Width="*"
                                    Binding="{Binding ServiceName}"
                                   />
                <DataGridTextColumn Header="Kategorie"
                                    Width="*"
                                    Binding="{Binding CategoryDisplay}"
                                   />
                <DataGridTextColumn Header="Preis (EUR)"
                                    Width="*"
                                    Binding="{Binding Price, StringFormat={}{0:F2} €}"
                                   />
                <DataGridTextColumn Header="Status"
                                    Width="*"
                                    Binding="{Binding Status}"
                                   />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
