<UserControl x:Class="Nest.Views.Reception.AllBookingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:layout="clr-namespace:Nest.Views.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <DockPanel Margin="{Binding PageMargin}">
        <StackPanel DockPanel.Dock="Top" Margin="10,4">
            <TextBlock Text="{Binding SynchronizationStatus}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding TicketStatus}" TextWrapping="Wrap"/>
        </StackPanel>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Visibility="{Binding ShowPageHeader, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="{StaticResource PageHeaderBrush}"
                Height="70">
            <TextBlock Style="{StaticResource PageHeaderTextStyle}" Text="Alle Reservierungen &amp; Aktivitäten"/>
        </Border>

        <!-- TOOLBAR -->
        <WrapPanel x:Name="SearchToolbar" Grid.Row="1" Margin="{Binding ToolbarMargin}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="Suche:"/>
            <TextBox Style="{StaticResource ToolbarSearchTextBoxStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Width="200"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="Status:"/>
            <ComboBox ItemsSource="{Binding StatusOptions}"
                      SelectedItem="{Binding SelectedStatus}"
                      Width="120"
                      Height="30"
                      Margin="0,0,10,0"/>
            </StackPanel>

            <Button x:Name="FilterReservations"
                    Content="Suchen"
                    Width="80"
                    Height="30"
                    Margin="0,0,10,8"
                    Style="{StaticResource SearchButtonStyle}"/>

            <Button x:Name="ClearSearch"
                    Content="Zurücksetzen"
                    Width="100"
                    Height="30"
                    Margin="0,0,10,8"
                    Style="{StaticResource ResetButtonStyle}"/>

            <Button x:Name="Refresh"
                    Content="Aktualisieren"
                    Width="100"
                    Height="30"
                    Margin="0,0,10,8"
                    Style="{StaticResource SearchButtonStyle}"/>
        </WrapPanel>

        <!-- TABS + TABELLE -->
        <TabControl x:Name="BookingTabs" Grid.Row="2" Margin="0,0,0,10">

            <!-- TAB 1: Zimmer-Reservierungen -->
            <TabItem Header="Zimmer-Reservierungen" FontWeight="Bold" IsSelected="True">
                <DataGrid x:Name="BookingGrid" Style="{StaticResource StandardResizableDataGridStyle}" ItemsSource="{Binding Reservations}"
                          SelectedItem="{Binding SelectedReservation}"
                          AutoGenerateColumns="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Buchung" Binding="{Binding ReservationCode}" Width="*" MinWidth="44" layout:DataGridColumnWidthSession.InitialMinWidth="220" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Gast" Binding="{Binding Guest}" Width="2*" MinWidth="44" layout:DataGridColumnWidthSession.InitialMinWidth="160" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Zimmer" Binding="{Binding Room}" Width="88" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="96" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Check-in" Binding="{Binding CheckInDate, StringFormat={}{0:dd.MM.yyyy}}" Width="104" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Check-out" Binding="{Binding CheckOutDate, StringFormat={}{0:dd.MM.yyyy}}" Width="104" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Nächte" Binding="{Binding Nights}" Width="80" MinWidth="44" ElementStyle="{StaticResource StandardGridNumberStyle}"/>
                        <DataGridTextColumn Header="Erw." Binding="{Binding Adults}" Width="64" MinWidth="44" ElementStyle="{StaticResource StandardGridNumberStyle}"/>
                        <DataGridTextColumn Header="Kinder" Binding="{Binding Children}" Width="80" MinWidth="44" ElementStyle="{StaticResource StandardGridNumberStyle}"/>
                        <DataGridTextColumn Header="Betrag" Binding="{Binding TotalAmount, StringFormat={}{0:F2} €}" Width="112" MinWidth="44" ElementStyle="{StaticResource StandardGridNumberStyle}"/>
                        <DataGridTextColumn Header="Zahlung" Binding="{Binding PaymentMethod, Converter={StaticResource GermanValueConverter}, Mode=OneWay}" Width="120" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="104" MinWidth="44">
                            <DataGridTextColumn.ElementStyle>
                                <StaticResource ResourceKey="StandardGridReservationStatusStyle"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- TAB 2: Event-Tickets -->
            <TabItem Header="Veranstaltungstickets" FontWeight="Bold">
                <DataGrid x:Name="TicketGrid" Style="{StaticResource StandardResizableDataGridStyle}" ItemsSource="{Binding TicketOrders}"
              AutoGenerateColumns="False"
              CanUserDeleteRows="False"
              IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ticket-Code" Binding="{Binding TicketCode}" Width="256" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Gast" Binding="{Binding GuestName}" Width="*" MinWidth="44" layout:DataGridColumnWidthSession.InitialMinWidth="160" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="E-Mail" Binding="{Binding GuestEmail}" Width="2*" MinWidth="44" layout:DataGridColumnWidthSession.InitialMinWidth="200" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Telefon" Binding="{Binding GuestPhone}" Width="144" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Anzahl" Binding="{Binding Quantity}" Width="88" MinWidth="44" ElementStyle="{StaticResource StandardGridNumberStyle}"/>
                        <DataGridTextColumn Header="Einzelpreis" Binding="{Binding UnitPrice, StringFormat={}{0:F2} €}" Width="112" MinWidth="44" ElementStyle="{StaticResource StandardGridNumberStyle}"/>
                        <DataGridTextColumn Header="Gesamt" Binding="{Binding TotalPrice, StringFormat={}{0:F2} €}" Width="112" MinWidth="44" ElementStyle="{StaticResource StandardGridNumberStyle}"/>
                        <DataGridTextColumn Header="Bestellt am" Binding="{Binding DateOrdered, StringFormat={}{0:dd.MM.yyyy}}" Width="112" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
    </DockPanel>
</UserControl>
