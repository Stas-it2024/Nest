<UserControl x:Class="Nest.Views.Reception.AllBookingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="{Binding PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Visibility="{Binding ShowPageHeader, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="#224E87"
                Height="70">
            <TextBlock Text="Alle Reservierungen &amp; Aktivitäten"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="25,0"/>
        </Border>

        <!-- TOOLBAR -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="{Binding ToolbarMargin}">
            <TextBlock Text="Suche:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Width="200"
                     Height="30"
                     VerticalContentAlignment="Center"
                     Margin="0,0,10,0"/>

            <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
            <ComboBox ItemsSource="{Binding StatusOptions}"
                      SelectedItem="{Binding SelectedStatus}"
                      Width="120"
                      Height="30"
                      Margin="0,0,10,0"/>

            <Button x:Name="FilterReservations"
                    Content="Suchen"
                    Width="80"
                    Height="30"
                    Background="#174A92"
                    Foreground="White"
                    FontWeight="Bold"/>

            <Button x:Name="ClearSearch"
                    Content="Zurücksetzen"
                    Width="100"
                    Height="30"
                    Margin="10,0,0,0"
                    Background="Gray"
                    Foreground="White"
                    FontWeight="Bold"/>

            <Button x:Name="Refresh"
                    Content="Aktualisieren"
                    Width="100"
                    Height="30"
                    Margin="10,0,0,0"
                    Background="#174A92"
                    Foreground="White"
                    FontWeight="Bold"/>
        </StackPanel>

        <!-- TABS + TABELLE -->
        <TabControl Grid.Row="2" Margin="0,0,0,10">

            <!-- TAB 1: Zimmer-Reservierungen -->
            <TabItem Header="Zimmer-Reservierungen" FontWeight="Bold" IsSelected="True">
                <DataGrid Style="{StaticResource StandardDataGridStyle}" ItemsSource="{Binding Reservations}"
                          AutoGenerateColumns="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Buchung" Binding="{Binding ReservationCode}" Width="110"/>
                        <DataGridTextColumn Header="Gast" Binding="{Binding Guest}" Width="140"/>
                        <DataGridTextColumn Header="Zimmer" Binding="{Binding Room}" Width="70"/>
                        <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="90"/>
                        <DataGridTextColumn Header="Check-in" Binding="{Binding CheckInDate, StringFormat={}{0:dd.MM.yyyy}}" Width="95"/>
                        <DataGridTextColumn Header="Check-out" Binding="{Binding CheckOutDate, StringFormat={}{0:dd.MM.yyyy}}" Width="95"/>
                        <DataGridTextColumn Header="Nächte" Binding="{Binding Nights}" Width="60"/>
                        <DataGridTextColumn Header="Erw." Binding="{Binding Adults}" Width="50"/>
                        <DataGridTextColumn Header="Kinder" Binding="{Binding Children}" Width="55"/>
                        <DataGridTextColumn Header="Betrag" Binding="{Binding TotalAmount, StringFormat={}{0:F2} €}" Width="90"/>
                        <DataGridTextColumn Header="Zahlung" Binding="{Binding PaymentMethod}" Width="90"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Reserviert">
                                            <Setter Property="Background" Value="Gold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Eingecheckt">
                                            <Setter Property="Background" Value="LightGreen"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Ausgecheckt">
                                            <Setter Property="Background" Value="LightGray"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Storniert">
                                            <Setter Property="Background" Value="LightCoral"/>
                                        </DataTrigger>
                                        <StaticResource ResourceKey="StandardDataGridTextSelectionTrigger"/>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- TAB 2: Event-Tickets -->
            <TabItem Header="Event-Tickets" FontWeight="Bold">
                <DataGrid Style="{StaticResource StandardDataGridStyle}" ItemsSource="{Binding TicketOrders}"
              AutoGenerateColumns="False"
              CanUserDeleteRows="False"
              IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ticket-Code" Binding="{Binding TicketCode}" Width="160"/>
                        <DataGridTextColumn Header="Gast" Binding="{Binding GuestName}" Width="140"/>
                        <DataGridTextColumn Header="E-Mail" Binding="{Binding GuestEmail}" Width="180"/>
                        <DataGridTextColumn Header="Telefon" Binding="{Binding GuestPhone}" Width="120"/>
                        <DataGridTextColumn Header="Anzahl" Binding="{Binding Quantity}" Width="70"/>
                        <DataGridTextColumn Header="Einzelpreis" Binding="{Binding UnitPrice, StringFormat={}{0:F2} €}" Width="100"/>
                        <DataGridTextColumn Header="Gesamt" Binding="{Binding TotalPrice, StringFormat={}{0:F2} €}" Width="100"/>
                        <DataGridTextColumn Header="Bestellt am" Binding="{Binding DateOrdered, StringFormat={}{0:dd.MM.yyyy}}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
