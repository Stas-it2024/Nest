<UserControl x:Class="Nest.Views.Reception.GastManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:Nest.Views.Behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Visibility="Collapsed" Background="#174A92" Height="50" Margin="0,0,0,10">
            <TextBlock Text="  Gästeverwaltung"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center"/>
        </Border>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="Suche:"/>
            <TextBox Style="{StaticResource ToolbarSearchTextBoxStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Width="250"/>
            </StackPanel>
            <Button x:Name="SearchGuests"
                    Content="Suchen"
                    Width="80"
                    Height="30"
                    Margin="0,0,10,8"
                    Style="{StaticResource SearchButtonStyle}"/>
            <Button x:Name="ClearSearch"
                    Content="Zurücksetzen"
                    Width="100"
                    Height="30"
                    Margin="0,0,10,8"
                    Style="{StaticResource ResetButtonStyle}"/>
            <Button x:Name="Refresh"
                    Content="Aktualisieren"
                    Width="100"
                    Height="30"
                    Margin="0,0,10,8"
                    Style="{StaticResource SearchButtonStyle}"/>
        </WrapPanel>

        <DataGrid layout:DataGridColumnWidthSession.TableKey="Reception.GastManagementView.0" Style="{StaticResource StandardResizableDataGridStyle}" Grid.Row="2"
                  ItemsSource="{Binding Guests}"
                  SelectedItem="{Binding SelectedGuest}"
                  AutoGenerateColumns="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  Margin="0,0,0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="64" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                <DataGridTextColumn Header="Vorname" Binding="{Binding FirstName}" Width="*" MinWidth="44" layout:DataGridColumnWidthSession.InitialMinWidth="120" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                <DataGridTextColumn Header="Nachname" Binding="{Binding LastName}" Width="*" MinWidth="44" layout:DataGridColumnWidthSession.InitialMinWidth="140" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                <DataGridTextColumn Header="E-Mail" Binding="{Binding Email}" Width="2*" MinWidth="44" layout:DataGridColumnWidthSession.InitialMinWidth="200" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="144" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                <DataGridTextColumn Header="Nationalität" Binding="{Binding Nationality}" Width="120" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                <DataGridTextColumn Header="Ausweistyp" Binding="{Binding IdType, Converter={StaticResource GermanValueConverter}, Mode=OneWay}" Width="120" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                <DataGridTextColumn Header="Ausweisnummer" Binding="{Binding IdNumber}" Width="160" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Grid.RowSpan="2" Background="#F0F4F8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Aufenthaltsverlauf"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#174A92"
                           Margin="10,8"/>

                <DataGrid layout:DataGridColumnWidthSession.TableKey="Reception.GastManagementView.1" Style="{StaticResource StandardResizableDataGridStyle}" ItemsSource="{Binding GuestHistory}"
                          AutoGenerateColumns="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True" Grid.Row="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Buchungsnr." Binding="{Binding ReservationCode}" Width="*" MinWidth="44" layout:DataGridColumnWidthSession.InitialMinWidth="220" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Zimmer" Binding="{Binding Room}" Width="88" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="96" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Check-in" Binding="{Binding CheckInDate, StringFormat={}{0:dd.MM.yyyy}}" Width="104" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Check-out" Binding="{Binding CheckOutDate, StringFormat={}{0:dd.MM.yyyy}}" Width="104" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                        <DataGridTextColumn Header="Nächte" Binding="{Binding Nights}" Width="80" MinWidth="44" ElementStyle="{StaticResource StandardGridNumberStyle}"/>
                        <DataGridTextColumn Header="Betrag" Binding="{Binding TotalAmount, StringFormat={}{0:F2} €}" Width="112" MinWidth="44" ElementStyle="{StaticResource StandardGridNumberStyle}"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="104" MinWidth="44">
                            <DataGridTextColumn.ElementStyle>
                                <StaticResource ResourceKey="StandardGridReservationStatusStyle"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
