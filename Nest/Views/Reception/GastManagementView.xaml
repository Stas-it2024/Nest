<UserControl x:Class="Nest.Views.Reception.GastManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Visibility="Collapsed" Background="#174A92" Height="50" Margin="0,0,0,10">
            <TextBlock Text="  Gästverwaltung"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,248">
            <TextBlock Text="Suche:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Width="250"
                     Height="30"
                     VerticalContentAlignment="Center"
                     Margin="0,0,10,0"/>
            <Button x:Name="SearchGuests"
                    Content="Suchen"
                    Width="80"
                    Height="30"
                    Background="#174A92"
                    Foreground="White"
                    FontWeight="Bold"/>
            <Button x:Name="ClearSearch"
                    Content="Zurücksetzen"
                    Width="100"
                    Height="30"
                    Margin="10,0,0,0"
                    Background="Gray"
                    Foreground="White"
                    FontWeight="Bold"/>
            <Button x:Name="Refresh"
                    Content="Aktualisieren"
                    Width="100"
                    Height="30"
                    Margin="10,0,0,0"
                    Background="#174A92"
                    Foreground="White"
                    FontWeight="Bold"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Guests}"
                  SelectedItem="{Binding SelectedGuest}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  Background="White"
                  BorderBrush="#D0D0D0"
                  BorderThickness="1"
                  MaxHeight="400" Margin="0,123,0,300" Grid.RowSpan="3">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Vorname" Binding="{Binding FirstName}" Width="100"/>
                <DataGridTextColumn Header="Nachname" Binding="{Binding LastName}" Width="120"/>
                <DataGridTextColumn Header="E-Mail" Binding="{Binding Email}" Width="180"/>
                <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="120"/>
                <DataGridTextColumn Header="Nationalität" Binding="{Binding Nationality}" Width="100"/>
                <DataGridTextColumn Header="Ausweistyp" Binding="{Binding IdType}" Width="100"/>
                <DataGridTextColumn Header="Ausweisnummer" Binding="{Binding IdNumber}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="#F0F4F8" Margin="0,103,0,0">
            <Grid Margin="0,54,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Aufenthaltsverlauf"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#174A92"
                           Margin="10,-35,0,55"/>

                <DataGrid ItemsSource="{Binding GuestHistory}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          Background="White"
                          BorderBrush="#D0D0D0"
                          BorderThickness="1" Margin="0,1,0,37" Grid.RowSpan="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Buchungsnr." Binding="{Binding ReservationCode}" Width="120"/>
                        <DataGridTextColumn Header="Zimmer" Binding="{Binding Room}" Width="80"/>
                        <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="80"/>
                        <DataGridTextColumn Header="Check-in" Binding="{Binding CheckInDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                        <DataGridTextColumn Header="Check-out" Binding="{Binding CheckOutDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                        <DataGridTextColumn Header="Nächte" Binding="{Binding Nights}" Width="60"/>
                        <DataGridTextColumn Header="Betrag" Binding="{Binding TotalAmount, StringFormat={}{0:F2} €}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Reserviert"><Setter Property="Background" Value="Gold"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Eingecheckt"><Setter Property="Background" Value="LightGreen"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Ausgecheckt"><Setter Property="Background" Value="LightGray"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Storniert"><Setter Property="Background" Value="LightCoral"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
