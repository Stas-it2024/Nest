<UserControl x:Class="Nest.Views.Reception.ReservationManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:layout="clr-namespace:Nest.Views.Behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cal="http://www.caliburnproject.org"        mc:Ignorable="d"
        d:Height="1080" d:Width="1480">

    <UserControl.Resources>
        <Style x:Key="ReservationSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource PageHeaderBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ReservationFlexibleCellText" TargetType="TextBlock"
               BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="ReservationCellStyle" TargetType="DataGridCell"
               BasedOn="{StaticResource StandardResizableCellStyle}">
            <Setter Property="Padding" Value="6,0,6,0"/>
        </Style>
        <Style x:Key="ReservationStatusCellText" TargetType="TextBlock"
               BasedOn="{StaticResource ReservationStatusTextStyle}">
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <!-- Match DataGridTextColumn.DefaultElementStyle's horizontal text margins. -->
            <Setter Property="Margin" Value="2,0,2,0"/>
        </Style>
        <!-- Keep native RadioButton keyboard/UI Automation behavior; only replace its visual. -->
        <Style x:Key="ReservationPaneChoiceStyle" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource PageHeaderBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PortalBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="ChoiceSurface" Margin="3" Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                <ContentPresenter RecognizesAccessKey="True"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <Border x:Name="ChoiceFocus" BorderThickness="2" CornerRadius="6"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                    Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PortalBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource PageHeaderBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource PageHeaderBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChoiceFocus" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ChoiceSurface" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel x:Name="StatusArea" Grid.Row="0" Margin="12,8">
            <TextBlock Text="{Binding SynchronizationStatus}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding DraftRoomWarning}" TextWrapping="Wrap"/>
        </StackPanel>
        <WrapPanel x:Name="PaneSwitcher" Grid.Row="1" Margin="12,4,4,0" Visibility="Collapsed"
                   AutomationProperties.Name="Reservierungsbereich auswählen">
            <RadioButton x:Name="ListPaneChoice" Content="Reservierungen" GroupName="ReservationPane"
                         IsChecked="True" Checked="PaneChoice_Checked" Style="{StaticResource ReservationPaneChoiceStyle}"
                         AutomationProperties.Name="Liste der Reservierungen anzeigen"/>
            <RadioButton x:Name="FormPaneChoice" Content="Neue Reservierung" GroupName="ReservationPane"
                         Checked="PaneChoice_Checked" Style="{StaticResource ReservationPaneChoiceStyle}"
                         AutomationProperties.Name="Formular für eine neue Reservierung anzeigen"/>
        </WrapPanel>
    <Grid x:Name="Workspace" Grid.Row="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="FormColumn" Width="440"/>
            <ColumnDefinition x:Name="ListColumn" Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Gastinformationen -->
        <Border x:Name="GuestFormPanel" Grid.Column="0" Background="#F0F4F8">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="FormTitle" Grid.Row="0" Text="Neue Reservierung"
                           Style="{StaticResource ReservationSectionTitle}"/>
                <ScrollViewer x:Name="FormScroller" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Gästinformationen -->
                <TextBlock Grid.Row="0"
                           Text="Gästeinformationen"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#FF174A92"
                           Margin="0,0,0,8"/>

                <Grid x:Name="NamePair" Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource RecLabel}" Text="Vorname *"/>
                        <TextBox Style="{StaticResource RecTextBox}"
                                 Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource RecLabel}" Text="Nachname *"/>
                        <TextBox Style="{StaticResource RecTextBox}"
                                 Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ContactPair" Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource RecLabel}" Text="E-Mail"/>
                        <TextBox Style="{StaticResource RecTextBox}"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource RecLabel}" Text="Telefon"/>
                        <TextBox Style="{StaticResource RecTextBox}"
                                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="IdentityPair" Grid.Row="3" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource RecLabel}" Text="Ausweistyp"/>
                        <ComboBox Style="{StaticResource RecComboBox}"
                                  ItemsSource="{Binding IdTypeList}"
                                  ItemTemplate="{StaticResource GermanValueItemTemplate}"
                                  SelectedItem="{Binding IdType}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource RecLabel}" Text="Ausweisnummer"/>
                        <TextBox Style="{StaticResource RecTextBox}"
                                 Text="{Binding IdNumber, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="4" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource RecLabel}" Text="Nationalität"/>
                        <TextBox Style="{StaticResource RecTextBox}"
                                 Text="{Binding Nationality, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="5" Background="#D0D0D0" Height="1" Margin="0,2,0,2"/>

                <TextBlock Grid.Row="6"
                           Text="Zimmer Aufenthalt"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF174A92"
                           Margin="0,0,0,8"/>

                <Grid Grid.Row="7" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource RecLabel}" Text="Zimmer *"/>
                        <ComboBox Style="{StaticResource RecComboBox}"
                                  ItemsSource="{Binding RoomList}"
                                  SelectedItem="{Binding SelectedRoom}"
                                  DisplayMemberPath="DisplayText"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="DatesPair" Grid.Row="8" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource RecLabel}" Text="Check-in *"/>
                        <DatePicker Style="{StaticResource RecDatePicker}"
                                    SelectedDate="{Binding CheckInDate}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource RecLabel}" Text="Check-out *"/>
                        <DatePicker Style="{StaticResource RecDatePicker}"
                                    SelectedDate="{Binding CheckOutDate}"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="PricePair" Grid.Row="9" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource RecLabel}" Text="Nächte"/>
                        <TextBox Style="{StaticResource RecTextBox}"
                                 Text="{Binding Nights, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource RecLabel}" Text="Preis (€)"/>
                        <TextBox Style="{StaticResource RecTextBox}"
                                 Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="PeoplePair" Grid.Row="10" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource RecLabel}" Text="Erwachsene"/>
                        <ComboBox Style="{StaticResource RecComboBox}"
                                  ItemsSource="{Binding AdultOptions}"
                                  SelectedItem="{Binding Adults}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource RecLabel}" Text="Kinder"/>
                        <ComboBox Style="{StaticResource RecComboBox}"
                                  ItemsSource="{Binding ChildOptions}"
                                  SelectedItem="{Binding Children}"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="PaymentPair" Grid.Row="11" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource RecLabel}" Text="Zahlungsmethode"/>
                        <ComboBox Style="{StaticResource RecComboBox}"
                                  ItemsSource="{Binding PaymentOptions}"
                                  ItemTemplate="{StaticResource GermanValueItemTemplate}"
                                  SelectedItem="{Binding PaymentType}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource RecLabel}" Text="Anzahlung (€)"/>
                        <TextBox Style="{StaticResource RecTextBox}"
                                 Text="{Binding Deposit, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="12" Text="Sonderwünsche" FontSize="12" Foreground="#333"/>
                <TextBox Grid.Row="13"
                         Style="{StaticResource RecTextBox}"
                         Height="30"
                         Text="{Binding SpecialRequests, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
                </Grid>
                </ScrollViewer>

                <Border x:Name="FormActionPanel" Grid.Row="2" Margin="0,12,0,0" Padding="0,12,0,0"
                        BorderBrush="{StaticResource PortalBorderBrush}" BorderThickness="0,1,0,0">
                <Button x:Name="SaveReservation"
                        Style="{StaticResource BlueButton}"
                        Content="RESERVIERUNG SPEICHERN"
                        Height="40"
                        FontSize="13"/>
                </Border>
            </Grid>
        </Border>

        <!-- Content Panel -->
        <Border x:Name="ListPanel" Grid.Column="1" Background="#F0F4F8">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ContentControl cal:View.Model="{Binding ActiveItem}"
                Grid.Row="0" Grid.RowSpan="2" />
                
                <Grid Grid.Row="0" Grid.RowSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveItem}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <TextBlock x:Name="ListTitle" Grid.Row="1" Text="Aktuelle Reservierungen"
                               Style="{StaticResource ReservationSectionTitle}"/>

                    <!-- SUCHE -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource ToolbarLabelStyle}" Text="Suche:"/>
                        <TextBox x:Name="ReservationSearch" Grid.Row="1" Style="{StaticResource ToolbarSearchTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Reservierungen nach Gast oder Buchungsnummer suchen"/>
                        <Button x:Name="ClearSearch"
                                Grid.Row="1" Grid.Column="1" Margin="8,0,0,0"
                                Content="Zurücksetzen"
                                Width="100" Height="30"
                                Style="{StaticResource ResetButtonStyle}"/>
                    </Grid>

                    <!-- AKTIONEN -->
                    <WrapPanel Grid.Row="3" Margin="0,0,0,8">
                        <Button x:Name="CheckIn"
                                Content="Check-in"
                                Width="100" Height="32"
                                Style="{StaticResource SuccessButtonStyle}"
                                FontWeight="Bold" Margin="0,0,10,4"/>
                        <Button x:Name="CheckOut"
                                Content="Check-out"
                                Width="100" Height="32"
                                Style="{StaticResource PrimaryButtonStyle}"
                                FontWeight="Bold" Margin="0,0,10,4"/>
                        <Button x:Name="CancelReservation"
                                Content="Stornieren"
                                Width="100" Height="32"
                                Style="{StaticResource DangerButtonStyle}"
                                FontWeight="Bold" Margin="0,0,0,4"/>
                    </WrapPanel>

                    <!-- DataGrid -->
                    <DataGrid layout:DataGridColumnWidthSession.TableKey="Reception.ReservationManagementView.0" x:Name="ReservationGrid" Grid.Row="4" Style="{StaticResource StandardResizableDataGridStyle}" ItemsSource="{Binding Reservations}"
                              CellStyle="{StaticResource ReservationCellStyle}"
                              SelectedItem="{Binding SelectedReservation}"
                              AutoGenerateColumns="False"
                              CanUserDeleteRows="False"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Buchungsnr." Binding="{Binding ReservationCode}"
                                                ElementStyle="{StaticResource ReservationFlexibleCellText}" Width="*" MinWidth="44" layout:DataGridColumnWidthSession.InitialMinWidth="220"/>
                            <DataGridTextColumn Header="Gast" Binding="{Binding GastName}"
                                                ElementStyle="{StaticResource ReservationFlexibleCellText}" Width="2*" MinWidth="44" layout:DataGridColumnWidthSession.InitialMinWidth="132"/>
                            <DataGridTextColumn Header="Zimmer" Binding="{Binding RoomNumber}" Width="88" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                            <DataGridTextColumn Header="Typ" Binding="{Binding RoomType}" Width="80" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                            <DataGridTextColumn Header="Check-out" Binding="{Binding CheckOut, StringFormat={}{0:dd.MM.yyyy}}" Width="104" MinWidth="44" ElementStyle="{StaticResource StandardGridTextStyle}"/>
                            <DataGridTextColumn Header="Nächte" Binding="{Binding Nights}" Width="80" MinWidth="44" ElementStyle="{StaticResource StandardGridNumberStyle}"/>
                            <DataGridTextColumn Header="Betrag (€)" Binding="{Binding Amount, StringFormat={}{0:F2}}" Width="104" MinWidth="44" ElementStyle="{StaticResource StandardGridNumberStyle}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="104" MinWidth="44">
                                <DataGridTextColumn.ElementStyle>
                                <StaticResource ResourceKey="ReservationStatusCellText"/>
                            </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</UserControl>
