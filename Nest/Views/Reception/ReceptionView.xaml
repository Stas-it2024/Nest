<UserControl x:Class="Nest.Views.Reception.ReceptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Nest.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <UserControl.Resources>
        <converters:SectionBackgroundConverter x:Key="SectionBackgroundConverter"/>
        <Style x:Key="ReceptionMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarMenuButtonBaseStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#214676"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#4A76AD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ReceptionBottomButtonStyle" TargetType="Button"
               BasedOn="{StaticResource ReceptionMenuButtonStyle}">
            <Setter Property="Height" Value="45"/>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="NavigationRoot" ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarPanel" Grid.Column="0" Width="240" HorizontalAlignment="Left"
                Panel.ZIndex="20" Background="{StaticResource StaffSidebarBrush}"
                AutomationProperties.Name="Hauptnavigation Rezeption">
            <Border.RenderTransform><TranslateTransform x:Name="SidebarShift"/></Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button x:Name="CloseNavigation" Grid.Row="0" Content="✕" Width="44" Height="40"
                        HorizontalAlignment="Right" Margin="4" Visibility="Collapsed"
                        Click="CloseNavigation_Click" ToolTip="Menü schließen (Esc)"
                        AutomationProperties.Name="Navigationsmenü schließen"/>
                <ScrollViewer x:Name="MenuScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                <StackPanel Margin="10,20">
                    <TextBlock Style="{StaticResource StaffBrandTextStyle}" Text="Grand Horizon"/>
                    <TextBlock Style="{StaticResource StaffHotelTextStyle}" Text="Hotel"/>
                    <Separator Margin="0,15"/>
                    <TextBlock Style="{StaticResource StaffInfoTextStyle}" Text="Empfangspersonal"/>
                    <TextBlock Style="{StaticResource StaffInfoTextStyle}" Text="(Rezeptionist)"/>
                </StackPanel>

                <StackPanel>
                    <Button x:Name="ShowReservations" Content="Reservierungen"
                            Style="{StaticResource ReceptionMenuButtonStyle}"
                            Background="{Binding SelectedSection, Converter={StaticResource SectionBackgroundConverter}, ConverterParameter=Reservations}"/>
                    <Button x:Name="ShowGuests" Content="Gäste"
                            Style="{StaticResource ReceptionMenuButtonStyle}"
                            Background="{Binding SelectedSection, Converter={StaticResource SectionBackgroundConverter}, ConverterParameter=Guests}"/>
                    <Button x:Name="ShowAllReservations" Content="Alle Buchungen"
                            Style="{StaticResource ReceptionMenuButtonStyle}"
                            Background="{Binding SelectedSection, Converter={StaticResource SectionBackgroundConverter}, ConverterParameter=AllBookings}"/>
                    <Button x:Name="ShowCustomerPortal" Content="Kundenportal"
                            Style="{StaticResource ReceptionMenuButtonStyle}"
                            Background="{Binding SelectedSection, Converter={StaticResource SectionBackgroundConverter}, ConverterParameter=CustomerPortal}"/>
                </StackPanel>
                </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Background="#0F284B">
                    <Button x:Name="Logout" Content="Abmelden" Foreground="#FFB6B6"
                            Background="#0F284B" Style="{StaticResource ReceptionBottomButtonStyle}"/>
                    <Button x:Name="Exit" Content="Beenden" Foreground="#B8D8FF"
                            Background="#0F284B" Style="{StaticResource ReceptionBottomButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ContentHost" Grid.Column="1" Background="#F3F5F8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border x:Name="CompactToolbar" Grid.Row="0" Height="48" Visibility="Collapsed"
                    Background="{StaticResource StaffSidebarBrush}">
                <Button x:Name="OpenNavigation" Content="☰" Width="44" Height="40" Margin="4"
                        HorizontalAlignment="Left" Click="OpenNavigation_Click"
                        ToolTip="Menü öffnen" AutomationProperties.Name="Navigationsmenü öffnen"/>
            </Border>
            <Border Grid.Row="1" Background="{StaticResource PageHeaderBrush}" MinHeight="70">
                <TextBlock x:Name="PageHeading" Text="{Binding PageTitle}" TextWrapping="Wrap"
                           Style="{StaticResource PageHeaderTextStyle}" Margin="25,10"/>
            </Border>
            <ContentControl x:Name="ActiveItem" Grid.Row="2"/>
        </Grid>
        <Border x:Name="NavigationScrim" Grid.ColumnSpan="2" Background="#66000000"
                Panel.ZIndex="10" Visibility="Collapsed" MouseLeftButtonDown="NavigationScrim_Click"/>
    </Grid>
</UserControl>
